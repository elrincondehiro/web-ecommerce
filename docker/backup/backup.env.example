# Configuración del backup (docker/backup/backup.sh, fase 11-7). En el VPS:
#   /opt/ecommerce/backup/backup.env  (chmod 600, propietario deploy; NUNCA en git)
# Separado de .env.prod: la tienda no necesita estas credenciales.

# Clave PÚBLICA de age (age1…). La privada solo en el gestor de contraseñas del usuario.
AGE_RECIPIENT=age1...

# R2 `hiro-backups` (jurisdicción EU → endpoint .eu), token «Object Read & Write» solo de ese bucket.
R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
R2_BUCKET=hiro-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Prefijo opcional dentro del bucket (p. ej. `pruebas/`)
R2_PREFIX=

# Uptime Kuma, monitor de tipo Push (fase 11-8): https://<kuma>/api/push/<token>. Vacío = sin aviso.
KUMA_PUSH_URL=

# Opcionales
# APP_DIR=/opt/ecommerce
# BACKUP_DIR=/var/backups/ecommerce
# KEEP_LOCAL=3
