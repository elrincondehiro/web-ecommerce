# ─────────────────────────────────────────────────────────────────────────────
# Credenciales de la infraestructura LOCAL de desarrollo (docker/compose.dev.yml)
# Copiar a docker/.env  →  cp docker/.env.example docker/.env
# ⚠️  Valores de EJEMPLO. En producción se usan secretos distintos y robustos
#     (compose.prod.yml + .env del VPS, nunca versionado).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa

# Meilisearch (>= 16 bytes)
MEILI_MASTER_KEY=dev_master_key_change_me_32chars_min

# SeaweedFS (S3 local que imita a Cloudflare R2)
S3_ACCESS_KEY_ID=seaweed
S3_SECRET_ACCESS_KEY=seaweed12345
S3_BUCKET=medusa

# Stripe CLI (solo perfil "stripe"; clave de TEST sk_test_…)
STRIPE_API_KEY=

# Umami (analítica, Fase MK-E; solo perfil "umami": pnpm infra:umami:up)
UMAMI_DB_PASSWORD=umami_dev
UMAMI_APP_SECRET=dev_umami_app_secret_change_me
# 0.0.0.0 para entrar desde otros dispositivos de la red local (por defecto solo 127.0.0.1)
UMAMI_BIND=127.0.0.1
UMAMI_PORT=3100

# Puertos publicados en 127.0.0.1 (cámbialos si chocan con otro proyecto local)
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700
S3_PORT=8333
SEAWEED_ADMIN_PORT=23646
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
