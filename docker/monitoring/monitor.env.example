# Variables de los compose de monitorización (fase 11-8). En la VM: /opt/monitor/monitor.env; en el
# VPS: /opt/monitor-agents/monitor.env (chmod 600; NUNCA en git).
# Clave PÚBLICA del hub de Beszel (Beszel → «Add system» la muestra; empieza por ssh-ed25519).
BESZEL_KEY=
# Solo en la VM: token del agente local (Beszel → «Add system» → token).
BESZEL_TOKEN_VM=

# ── Bugsink (fase 12-B, solo en la VM) ──
# Clave de Django: `openssl rand -base64 48`.
BUGSINK_SECRET_KEY=
# Usuario inicial «email:contraseña» (solo se crea si no hay usuarios; cámbiala al entrar).
BUGSINK_SUPERUSER=
# API key de Resend para las alertas por email (una propia, «bugsink», solo envío) y el remitente
# de un dominio verificado en Resend, p. ej. «Errores <errores@develop.hirobordercollie.es>».
BUGSINK_RESEND_API_KEY=
BUGSINK_FROM_EMAIL=
