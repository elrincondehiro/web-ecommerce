# Variables de los compose de monitorización (fase 11-8). En la VM: /opt/monitor/monitor.env; en el
# VPS: /opt/monitor-agents/monitor.env (chmod 600; NUNCA en git).
# Clave PÚBLICA del hub de Beszel (Beszel → «Add system» la muestra; empieza por ssh-ed25519).
BESZEL_KEY=
# Solo en la VM: token del agente local (Beszel → «Add system» → token).
BESZEL_TOKEN_VM=
