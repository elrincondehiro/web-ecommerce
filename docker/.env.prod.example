# ─────────────────────────────────────────────────────────────────────────────
# Variables de la pila de PRODUCCIÓN (docker/compose.prod.yml). Fase 10.
#   cp docker/.env.prod.example docker/.env.prod   (en el VPS; NUNCA en git)
# Generar secretos:  openssl rand -hex 32
# ⚠️  Valores de EJEMPLO. Las marcadas «obligatoria» paran el compose si están vacías.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imágenes: de dónde y qué versión (README §10) ────────────────────────────
# GHCR (GitHub): ghcr.io + elrincondehiro · Gitea: git.hirokobu.duckdns.org + jacknoddy
REGISTRY=ghcr.io
IMAGE_NAMESPACE=elrincondehiro
# Tag desplegable: X.Y.Z (release) o sha-<7> / main (pruebas). Nunca latest.
# Hasta la fase 11 el storefront de CI es de fixtures (tags `<tag>-fixtures`, NO desplegable): el
# storefront real se construye contra la API del VPS (docs/fases/fase10.md §4.5).
IMAGE_TAG=0.1.0

# ── Dominios (Caddy) ─────────────────────────────────────────────────────────
STORE_DOMAIN=tienda.example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Vacío = certificados automáticos de Caddy. Fase 11 (Cloudflare Full strict + Origin CA):
# CADDY_TLS=tls /certs/origin.pem /certs/origin.key
CADDY_TLS=

# ── PostgreSQL (obligatorias) ────────────────────────────────────────────────
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=medusa

# ── Meilisearch ──────────────────────────────────────────────────────────────
# Master key (≥ 16 bytes, obligatoria): SOLO para administrar Meilisearch, nunca en el backend.
MEILI_MASTER_KEY=
# Key PROPIA del backend (obligatoria), creada con la master key (docs/fases/fase10.md §4.3).
MEILISEARCH_API_KEY=
SEARCH_STOCK_SYNC_CRON=*/5 * * * *

# ── Backend Medusa (server + worker) ─────────────────────────────────────────
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=https://tienda.example.com
ADMIN_CORS=https://admin.example.com
AUTH_CORS=https://admin.example.com,https://tienda.example.com
# Enlaces de los emails (reset, verificación, pedido)
STOREFRONT_URL=https://tienda.example.com

# Ficheros: Cloudflare R2 (fase 11)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_FILE_URL=https://img.example.com
S3_PREFIX=

# Stripe (opcionales: sin STRIPE_API_KEY, Medusa arranca sin el proveedor de pago)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails: resend en producción (smtp solo para la prueba local con Mailpit)
EMAIL_TRANSPORT=resend
EMAIL_FROM="El Rincón de Hiro <pedidos@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=1025
EMAIL_ASSETS_URL=
SHOP_NOTIFY_EMAIL=

# ── Storefront ───────────────────────────────────────────────────────────────
# Runtime: publishable key del canal "Tienda online" (también se usa en el build) y la de Stripe.
MEDUSA_PUBLISHABLE_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Solo para `docker compose build` (build en el VPS/local; las imágenes de CI ya vienen hechas):
# dominio público, origen de las imágenes y API que se consulta al construir el catálogo.
SITE_URL=https://tienda.example.com
IMAGE_BASE_URL=https://img.example.com
STOREFRONT_BUILD_BACKEND_URL=https://api.example.com
STOREFRONT_MAX_PRODUCTS=
# Opcional: clave fija de las props cifradas de server islands (pnpm --filter storefront exec astro create-key)
ASTRO_KEY=
