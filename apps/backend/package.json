{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Backend Medusa v2 de web-ecommerce",
  "license": "MIT",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "seed:mock": "medusa exec ./src/scripts/seed-mock.ts",
    "seed:mock:v2": "medusa exec ./src/scripts/seed-mock-v2.ts",
    "seed:mock:ofertas": "medusa exec ./src/scripts/seed-mock-ofertas.ts",
    "images:mock": "medusa exec ./src/scripts/mock-images.ts",
    "images:import": "medusa exec ./src/scripts/import-images.ts",
    "stripe:region": "medusa exec ./src/scripts/stripe-region.ts",
    "stock:mock": "medusa exec ./src/scripts/stock-mock.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@rokmohar/medusa-plugin-meilisearch": "2.3.1",
    "emails": "workspace:*",
    "resend": "6.32.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "nodemailer": "10.0.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.21.0"
  }
}
