{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Backend Medusa v2 de web-ecommerce",
  "license": "MIT",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "images:mock": "medusa exec ./src/scripts/mock-images.ts",
    "images:import": "medusa exec ./src/scripts/import-images.ts",
    "catalog:import": "medusa exec ./src/scripts/import-catalog.ts",
    "catalog:mock": "medusa exec ./src/scripts/catalog-mock.ts",
    "stripe:region": "medusa exec ./src/scripts/stripe-region.ts",
    "stock:mock": "medusa exec ./src/scripts/stock-mock.ts",
    "correas:sync": "medusa exec ./src/scripts/correas-sync.ts",
    "carts:cleanup": "medusa exec ./src/scripts/delete-stale-carts.ts",
    "codes:create": "medusa exec ./src/scripts/codes-create.ts",
    "orders:assign": "medusa exec ./src/scripts/orders-assign.ts",
    "orders:link-guests": "medusa exec ./src/scripts/orders-link-guests.ts",
    "points:accrue": "medusa exec ./src/scripts/points-accrue.ts",
    "points:adjust": "medusa exec ./src/scripts/points-adjust.ts",
    "points:close-account": "medusa exec ./src/scripts/points-close-account.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@rokmohar/medusa-plugin-meilisearch": "2.3.1",
    "emails": "workspace:*",
    "resend": "6.34.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "nodemailer": "10.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.22.0"
  }
}
