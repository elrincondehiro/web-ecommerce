# Específico del backend (el .gitignore raíz cubre node_modules, .env, dist…)
/uploads
/.medusa
/build
medusa-db.sql
/.cache
# Cargas reales del importador de catálogo (datos del negocio): solo se versionan la plantilla y
# el árbol de categorías del catálogo de prueba (catalog:mock genera productos.csv, ignorado)
/catalog/*
!/catalog/plantilla/
!/catalog/mock/
/catalog/mock/*
!/catalog/mock/categorias.csv
