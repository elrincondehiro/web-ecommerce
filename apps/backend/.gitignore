# Específico del backend (el .gitignore raíz cubre node_modules, .env, dist…)
/uploads
/.medusa
/build
medusa-db.sql
/.cache
# Catálogo: solo se versionan las plantillas y el catálogo de desarrollo (mock/), salvo su
# productos.csv (lo genera catalog:mock). Las cargas reales (otras carpetas) quedan fuera de git.
/catalog/*
!/catalog/plantilla/
!/catalog/mock/
/catalog/mock/productos.csv
