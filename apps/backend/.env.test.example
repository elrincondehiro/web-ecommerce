# Tests de integración de Medusa (@medusajs/test-utils): crean una BD temporal por suite.
# Copiar a .env.test →  cp .env.test.example .env.test
DB_HOST=localhost
DB_USERNAME=medusa
DB_PASSWORD=medusa
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:4321
JWT_SECRET=test_jwt_secret
COOKIE_SECRET=test_cookie_secret
MEDUSA_DISABLE_TELEMETRY=true
