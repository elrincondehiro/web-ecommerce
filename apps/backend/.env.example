# ─────────────────────────────────────────────────────────────────────────────
# Backend Medusa — variables de DESARROLLO (copiar a .env).  cp .env.example .env
# ⚠️ Valores de ejemplo. En producción: secretos robustos en el .env del VPS.
# Generar secretos:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Infra local (docker/compose.dev.yml)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

# CORS (storefront Astro en :4321, admin en :9000)
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:4321

# Secretos (cambiar SIEMPRE fuera de local)
JWT_SECRET=dev_jwt_secret_change_me
COOKIE_SECRET=dev_cookie_secret_change_me
# Clave de cifrado de MFA del módulo Auth (32 bytes hex)
AUTH_MFA_ENCRYPTION_KEY=

# Proceso: shared (dev) | server | worker (prod)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# Onboarding del admin (lo escribe create-medusa-app; "default" = sin starter Next.js)
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Telemetría de Medusa desactivada (decisión P6 fase 2)
MEDUSA_DISABLE_TELEMETRY=true

# Ficheros (fase 6): SeaweedFS local (credenciales de docker/.env) · prod: Cloudflare R2.
# Sin S3_BUCKET se usa el proveedor local de Medusa (CI).
# prod: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com · S3_FILE_URL=https://img.elrincondehiro.com
# S3_FORCE_PATH_STYLE=true es necesario en SeaweedFS. S3_PREFIX opcional (p. ej. "products/").
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=medusa
S3_ACCESS_KEY_ID=seaweed
S3_SECRET_ACCESS_KEY=seaweed12345
S3_FORCE_PATH_STYLE=true
S3_FILE_URL=http://localhost:8333/medusa
S3_PREFIX=

# Pagos (fase 5): Stripe en modo TEST (Dashboard → Desarrolladores → Claves de API).
# Sin STRIPE_API_KEY no se registra el proveedor (CI). El whsec_ lo da el CLI:
#   docker compose --env-file docker/.env -f docker/compose.dev.yml run --rm stripe-cli listen --print-secret
# prod: sk_live_… + el secreto del endpoint creado en el Dashboard (api.dominio/hooks/payment/stripe_stripe).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Búsqueda (fase 7): proveedor Meilisearch del Search Module (solo backend, NUNCA al storefront).
# dev: la MEILI_MASTER_KEY de docker/.env. prod: una key propia del backend (pendiente de la fase 10).
# Sin MEILISEARCH_HOST (CI, tests) Medusa usa su proveedor PostgreSQL; en producción es obligatoria.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=
# Cada cuánto se reindexa `in_stock` de los productos con cambios de stock/reservas (fase 7, D8).
# Cron de Medusa (scheduled job, solo worker/shared). Por defecto cada 5 min.
SEARCH_STOCK_SYNC_CRON="*/5 * * * *"

# Emails (fase 8): proveedor propio `resend-notification` (plantillas de packages/emails).
# EMAIL_TRANSPORT: smtp → Mailpit (solo desarrollo, UI http://localhost:8025) · resend → API de Resend.
# Sin EMAIL_TRANSPORT no se envían emails (CI, tests). En producción es obligatorio (resend).
# RESEND_API_KEY: solo backend (server y worker). Nunca en logs ni en el storefront.
# Pruebas con Resend sin dañar la reputación del dominio: delivered@resend.dev, bounced@resend.dev.
EMAIL_TRANSPORT=smtp
EMAIL_FROM="El Rincón de Hiro <pedidos@develop.hirobordercollie.es>"
# Sin reply-to por ahora (el dominio no recibe correo); el pie de los emails lo avisa.
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
# URL pública del storefront (enlaces de los emails) y origen del logo (/email/logo.png).
# Sin EMAIL_ASSETS_URL se usa STOREFRONT_URL. Con Resend a un buzón real, el logo necesita una URL
# pública (localhost no se ve fuera de tu máquina; en Mailpit sí).
STOREFRONT_URL=http://localhost:4321
EMAIL_ASSETS_URL=
