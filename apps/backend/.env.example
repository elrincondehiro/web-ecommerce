# ─────────────────────────────────────────────────────────────────────────────
# Backend Medusa — variables de DESARROLLO (copiar a .env).  cp .env.example .env
# ⚠️ Valores de ejemplo. En producción: secretos robustos en el .env del VPS.
# Generar secretos:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Infra local (docker/compose.dev.yml)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

# CORS (storefront Astro en :4321, admin en :9000)
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:4321

# Secretos (cambiar SIEMPRE fuera de local)
JWT_SECRET=dev_jwt_secret_change_me
COOKIE_SECRET=dev_cookie_secret_change_me
# Clave de cifrado de MFA del módulo Auth (32 bytes hex)
AUTH_MFA_ENCRYPTION_KEY=

# Proceso: shared (dev) | server | worker (prod)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000

# Onboarding del admin (lo escribe create-medusa-app; "default" = sin starter Next.js)
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Telemetría de Medusa desactivada (decisión P6 fase 2)
MEDUSA_DISABLE_TELEMETRY=true
