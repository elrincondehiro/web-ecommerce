---
// Esqueleto común de las fichas (Fase DS): <head> (SEO, JSON-LD, estilos de datos), migas,
// galería, título con ♡, bloque de descatalogado, descripción y analíticos, LiveSync y
// relacionados. Cada diseño de ficha (src/disenos/producto/*.astro) pone dentro lo suyo:
//   - slot por defecto: la compra (BuyBox, configurador…), solo si NO está descatalogado;
//   - slot "after": bajo la compra (guías, resumen de opciones), también en los descatalogados;
//   - slot "head": estilos con hash CSP (HeadStyle, SwatchStyles: AGENTS §3.2, van en el <head>).
// Los datos los prepara una vez pages/producto/[handle].astro (`FichaData`, lib/ficha.ts).
import { buttonVariants } from "$lib/components/ui/button";
import { BUY_FORM_ID } from "$lib/wishlist";
import { listingPageKey } from "$lib/listing-pages";
import type { FichaData } from "$lib/ficha";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AnalyticsTable from "../../components/AnalyticsTable.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import LiveSync from "../../components/LiveSync.astro";
import WishButton from "../../components/WishButton.astro";
import RelatedProducts from "../../components/RelatedProducts.astro";
import HeadStyle from "../../components/HeadStyle.astro";
import RichText from "../../components/RichText.astro";

type Props = FichaData & {
  /** Diseño: qué guarda el ♡ («variant» = la variante elegida). */
  wishVariant: boolean;
  /** Diseño: variante inicial del ♡ si guarda la variante. */
  wishKey?: string | undefined;
  /** Diseño: false si su formulario de compra ya lleva `product_id`. */
  wishProductField: boolean;
};
const {
  product,
  crumbs,
  seo,
  discontinued,
  onward,
  picker,
  gallery,
  hasAnalytics,
  related,
  wishVariant,
  wishKey,
  wishProductField,
} = Astro.props;
---

<BaseLayout {...seo}>
  <slot name="head" slot="head" />
  {/* Selector (Fase O; perf CSS-A): sus reglas y colores, solo en las fichas que lo tienen */}
  <HeadStyle slot="head" css={picker ? picker.headCss : ""} />
  <Breadcrumbs items={crumbs} />
  {/* `.vp` (Fase O): el CSS del selector abarca la galería (fotos del valor elegido) */}
  <div class:list={["grid gap-8 md:grid-cols-2", picker && "vp"]}>
    <ProductGallery
      images={gallery.general}
      alt={product.title}
      groups={gallery.groups}
      selected={picker?.picker.selected.a}
    />
    <div class="flex min-w-0 flex-col gap-6">
      <div class="flex items-start justify-between gap-4">
        <div class="flex min-w-0 flex-col gap-2">
          <h1 class="text-3xl font-semibold tracking-tight">{product.title}</h1>
          {product.subtitle && <p class="text-muted-foreground">{product.subtitle}</p>}
        </div>
        {!discontinued && (
          <WishButton
            variant="title"
            form={BUY_FORM_ID}
            wish={wishVariant ? "variant" : "product"}
            initialKey={wishVariant ? wishKey : undefined}
            productField={wishProductField}
            productId={product.id}
            productTitle={product.title}
            back={`/producto/${product.handle}/`}
          />
        )}
      </div>

      {discontinued ? (
        <div class="flex flex-col items-start gap-3 rounded-lg border border-border bg-muted p-4">
          <p class="font-semibold">Este producto está descatalogado</p>
          <p class="text-sm text-muted-foreground">Ya no lo vendemos.</p>
          <a href={onward.href} class={buttonVariants({ variant: "default" })}>
            {onward.text}
          </a>
        </div>
      ) : (
        <slot />
      )}

      <slot name="after" />
    </div>
  </div>
  {/* Fila 2: información del producto a todo el ancho, bajo galería y compra (en móvil, apilada
      igual que antes: detrás de la columna de compra). */}
  {(product.description || hasAnalytics) && (
    <div class="mt-10 flex max-w-prose flex-col gap-8">
      {product.description && (
        <section aria-labelledby="descripcion">
          <h2 id="descripcion" class="mb-2 font-semibold">
            Descripción
          </h2>
          <RichText text={product.description} class="leading-relaxed text-muted-foreground" />
        </section>
      )}
      <AnalyticsTable product={product} />
    </div>
  )}
  {/* Una island para la ficha y sus relacionados (Fase R-2, P6): la clave es la del bloque. */}
  {!discontinued && (
    <LiveSync
      productId={product.id}
      relatedKey={related.length ? listingPageKey(related.map((p) => p.id)) : undefined}
    />
  )}
  <RelatedProducts products={related} back={`/producto/${product.handle}/`} />
</BaseLayout>
