---
// Eliminar mi cuenta (fase 13): la baja es inmediata (workflow `delete-account` del backend).
// Sin JS. Para que no se borre sin querer (un clic, un gestor de contraseñas que rellena el
// formulario) hay que ESCRIBIR la frase y la contraseña; el backend vuelve a comprobar las dos.
// Con pedidos en curso no se borra nada y se explica.
import { buttonVariants } from "$lib/components/ui/button";
import { ACCOUNT_PATH, DELETE_PATH, DELETE_PHRASE, accountActionUrl } from "$lib/account";
import { accountPage, requireCustomer } from "$lib/account-page";
import AccountLayout from "../../components/account/AccountLayout.astro";
import AccountNotice from "../../components/account/AccountNotice.astro";
import Field from "../../components/checkout/Field.astro";
import PasswordField from "../../components/account/PasswordField.astro";

export const prerender = false;

const flash = accountPage(Astro);
const session = await requireCustomer(Astro);
if (!session.ok) return session.redirect;
const errors = flash.errors ?? {};
---

<AccountLayout title="Eliminar mi cuenta">
  <h1 class="mb-6 text-3xl font-semibold tracking-tight">Eliminar mi cuenta</h1>
  <AccountNotice code={flash.code} />
  <div class="flex max-w-xl flex-col gap-4 text-sm">
    <p>
      Si eliminas tu cuenta, la borraremos <strong>en el momento</strong> y ya no podrás entrar.
      Borraremos tus datos personales, tus direcciones, las fichas de tus mascotas, tu lista de
      deseos, tus avisos de stock y tus preferencias de comunicaciones.{" "}
      <strong>Perderás el saldo de puntos</strong> que tengas.
    </p>
    <p>
      Conservaremos los datos de tus pedidos el tiempo que exige la normativa fiscal. No se puede
      eliminar la cuenta mientras haya pedidos en curso (sin enviar o con una devolución abierta).
    </p>
    <form
      method="post"
      action={accountActionUrl(DELETE_PATH, "account.deleteAccount")}
      autocomplete="off"
      class="mt-2 flex flex-col gap-4 rounded-md border-2 border-line bg-card shadow-sm p-4 sm:p-6"
    >
      <div class="flex flex-col gap-1">
        <label for="f-reason" class="font-medium">
          ¿Por qué te vas? <span class="font-normal text-muted-foreground">(opcional)</span>
        </label>
        <textarea
          id="f-reason"
          name="reason"
          rows="3"
          maxlength="500"
          aria-invalid={errors.reason ? "true" : undefined}
          aria-describedby={errors.reason ? "f-reason-error" : undefined}
          class="rounded-md border-2 border-line bg-background px-3 py-2 text-base aria-invalid:border-destructive sm:text-sm"
        >{flash.values?.reason ?? ""}</textarea>
        {errors.reason && (
          <p id="f-reason-error" class="text-destructive">
            {errors.reason}
          </p>
        )}
      </div>
      <Field
        name="phrase"
        label={`Para confirmar, escribe «${DELETE_PHRASE}»`}
        required
        maxlength={100}
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        data-1p-ignore
        data-lpignore="true"
        data-bwignore
        value={flash.values?.phrase ?? ""}
        error={errors.phrase}
      />
      <PasswordField
        autocomplete="current-password"
        label="Tu contraseña"
        error={errors.password}
      />
      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" class={buttonVariants({ variant: "destructive" })}>
          Eliminar mi cuenta
        </button>
        <a href={ACCOUNT_PATH} class="underline underline-offset-4">
          Cancelar
        </a>
      </div>
    </form>
  </div>
</AccountLayout>
