---
// Detalle de un pedido de la cuenta (fase 9). GET /store/orders/:id NO comprueba el dueño en
// Medusa 2.21.2 (cualquiera con el id lo lee): aquí solo se muestra si `customer_id` es el del
// cliente con sesión; si no, 404 (no se revela que existe). 0 JS.
import { lineQuantityLabel } from "$lib/bulk";
import { buttonVariants } from "$lib/components/ui/button";
import { ORDERS_PATH, orderStatusLabel } from "$lib/account";
import { requireCustomer } from "$lib/account-page";
import { isValidId } from "$lib/cart";
import { formatPrice } from "$lib/format";
import {
  getOrderTransfer,
  orderCajaStates,
  retrieveCustomerOrder,
  type OrderTransfer,
  type StoreOrder,
} from "$lib/medusa";
import AccountLayout from "../../../components/account/AccountLayout.astro";
import { cajaContents, isCajaLine } from "$lib/line-data";
import LineInfo from "../../../components/order/LineInfo.astro";
import OrderTotals from "../../../components/order/OrderTotals.astro";
import { Image } from "astro:assets";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
const { id } = Astro.params;
if (!isValidId(id)) return new Response(null, { status: 404 });
const session = await requireCustomer(Astro);
if (!session.ok) return session.redirect;

let order: StoreOrder | null = null;
try {
  order = await retrieveCustomerOrder(id);
} catch (err) {
  if ((err as { status?: unknown } | null)?.status !== 404) throw err;
}
if (!order || order.customer_id !== session.customer.id) {
  return new Response(null, { status: 404 });
}
// Transferencia pendiente (Fase PG-3): datos para pagarla. Si falla, la página sigue sin ellos.
let transfer: OrderTransfer | null = null;
try {
  transfer = await getOrderTransfer(order.id, session.token);
} catch (err) {
  Astro.logger.error(`pedido transferencia: ${err instanceof Error ? err.message : String(err)}`);
}
const currency = order.currency_code ?? "eur";
const addr = order.shipping_address;
// Caja de snacks (Fase CS-4): el contenido se ve desde que se propone
const cajaStates = await orderCajaStates(order.id);
const cajasVisible = new Set(
  [...cajaStates].filter(([, estado]) => estado !== "preparando").map(([id]) => id),
);
// El contenido de cada caja va dentro de ella (LineInfo), no como líneas sueltas a 0 €
const contents = cajaContents(order?.items, cajasVisible);
const orderLines = (order?.items ?? []).filter((i) => !i.metadata?.caja_de);
const dateFmt = new Intl.DateTimeFormat("es-ES", { dateStyle: "long", timeZone: "Europe/Madrid" });
---

<AccountLayout title={`Pedido #${order.display_id}`}>
  <a href={ORDERS_PATH} class="mb-4 inline-block text-sm underline underline-offset-4">
    ← Mis pedidos
  </a>
  <h1 class="mb-2 text-3xl font-semibold tracking-tight">Pedido #{order.display_id}</h1>
  <p class="mb-6 text-muted-foreground">
    {dateFmt.format(new Date(order.created_at))} · {orderStatusLabel(order)}
  </p>

  <div class="flex max-w-2xl flex-col gap-6">
    {transfer && (
      <section
        aria-labelledby="pedido-transferencia"
        class="rounded-md border-2 border-primary bg-card p-4 shadow-sm"
      >
        <h2 id="pedido-transferencia" class="mb-2 text-lg font-semibold">
          Pendiente de pago por transferencia
        </h2>
        <p class="mb-3 text-sm">
          Haz la transferencia antes del <strong>{transfer.lastDay}</strong> (incluido). Si no la
          recibimos, el pedido se cancelará. Preparamos el pedido cuando llega.
        </p>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          <dt class="text-muted-foreground">Importe</dt>
          <dd class="font-semibold tabular-nums">{transfer.amount}</dd>
          <dt class="text-muted-foreground">IBAN</dt>
          <dd class="font-mono select-all">{transfer.iban}</dd>
          <dt class="text-muted-foreground">Titular</dt>
          <dd>{transfer.holder}</dd>
          <dt class="text-muted-foreground">Concepto</dt>
          <dd class="font-mono select-all">{transfer.concept}</dd>
        </dl>
      </section>
    )}
    <section
      aria-labelledby="pedido-lineas"
      class="rounded-md border-2 border-line bg-card shadow-sm p-4"
    >
      <h2 id="pedido-lineas" class="mb-3 text-lg font-semibold">
        Productos
      </h2>
      <ul class="divide-y-2 divide-line border-t-2 border-line text-sm">
        {orderLines.map((item) => (
          <li class="flex items-center gap-3 py-3">
            {/* Miniatura con el marco de la web (como el carrito; Fase L-1). */}
            {item.thumbnail ? (
              <Image
                src={item.thumbnail}
                alt=""
                width={56}
                height={56}
                fit="cover"
                format="webp"
                loading="lazy"
                decoding="async"
                class="size-14 shrink-0 rounded-md border-2 border-line bg-muted object-cover shadow-xs"
              />
            ) : (
              <span class="block size-14 shrink-0 rounded-md border-2 border-line bg-muted shadow-xs" />
            )}
            <span class="min-w-0 flex-1">
              <span class="tabular-nums">{lineQuantityLabel(item)}</span>{" "}
              {item.product_handle ? (
                <a href={`/producto/${item.product_handle}/`} class="underline underline-offset-4">
                  {item.product_title}
                </a>
              ) : (
                item.product_title
              )}
              {item.variant_title && item.variant_title !== "Única" && (
                <span class="text-muted-foreground"> · {item.variant_title}</span>
              )}
              <LineInfo
                metadata={item.metadata}
                state={
                  isCajaLine(item.metadata) ? (cajaStates.get(item.id) ?? "preparando") : undefined
                }
                contents={contents.get(item.id)}
              />
            </span>
            <span class="shrink-0 tabular-nums">
              {formatPrice(item.original_total ?? item.total ?? 0, currency)}
            </span>
          </li>
        ))}
      </ul>
      <OrderTotals
        totals={order}
        currency={currency}
        shippingLabel={`Envío${order.shipping_methods?.[0]?.name ? ` (${order.shipping_methods[0].name})` : ""}`}
      />
    </section>

    {addr && (
      <section
        aria-labelledby="pedido-envio"
        class="rounded-md border-2 border-line bg-card shadow-sm p-4 text-sm"
      >
        <h2 id="pedido-envio" class="mb-2 text-lg font-semibold">
          Dirección de envío
        </h2>
        <address class="not-italic">
          {addr.first_name} {addr.last_name}
          <br />
          {addr.address_1}
          {addr.address_2 && (
            <>
              <br />
              {addr.address_2}
            </>
          )}
          <br />
          {addr.postal_code} {addr.city} ({addr.province})
        </address>
      </section>
    )}
  </div>
  <a href="/productos/" class:list={[buttonVariants({ variant: "outline" }), "mt-8"]}>
    Seguir comprando
  </a>
</AccountLayout>
