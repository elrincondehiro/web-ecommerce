---
// Confirmación del pedido (fase 5): on-demand, noindex, 0 JS. La Store API devuelve pedidos por
// id SIN autenticar (GET /store/orders/:id, Medusa 2.21.2), así que los datos solo se muestran
// si la cookie last_order (httpOnly, 1 h, P7) coincide con el id: una URL compartida no expone
// la dirección. Sin cookie: "Pedido recibido" genérico. Historial completo: cuenta (fase 9).
import { lineQuantityLabel } from "$lib/bulk";
import { buttonVariants } from "$lib/components/ui/button";
import { isValidId } from "$lib/cart";
import { LAST_ORDER_COOKIE, canViewOrder } from "$lib/checkout";
import { formatPrice } from "$lib/format";
import { getOrderTransfer, retrieveOrder, type OrderTransfer, type StoreOrder } from "$lib/medusa";
import { ORDERS_PATH } from "$lib/account";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { lineDetails } from "$lib/correa";
import OrderTotals from "../../components/order/OrderTotals.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const { id } = Astro.params;
if (!isValidId(id)) return new Response(null, { status: 404 });

let order: StoreOrder | null = null;
if (canViewOrder(Astro.cookies.get(LAST_ORDER_COOKIE)?.value, id)) {
  try {
    order = await retrieveOrder(id);
  } catch (err) {
    Astro.logger.error(`pedido: ${err instanceof Error ? err.message : String(err)}`);
  }
}
const currency = order?.currency_code ?? "eur";
const addr = order?.shipping_address;
// Fase PG: Bizum se cobra al momento (captured); tarjeta y PayPal se autorizan y se capturan al
// preparar el envío (authorized).
const paid = order?.payment_status === "captured";
// Transferencia (Fase PG-3; solo con cuenta): los datos para pagar, en la ficha del pedido.
const token = Astro.locals.customerToken;
let transfer: OrderTransfer | null = null;
if (order && token) {
  try {
    transfer = await getOrderTransfer(order.id, token);
  } catch (err) {
    Astro.logger.error(`pedido transferencia: ${err instanceof Error ? err.message : String(err)}`);
  }
}
---

<BaseLayout
  title="Pedido recibido"
  description="Confirmación de tu pedido en El Rincón de Hiro."
  noindex
  cartCount={0}
  cartClient={false}
>
  <h1 class="mb-2 text-3xl font-semibold tracking-tight">¡Gracias por tu pedido!</h1>
  {order ? (
    <div class="flex max-w-2xl flex-col gap-6">
      <p class="text-muted-foreground">
        Pedido <strong class="text-foreground">#{order.display_id}</strong>. Te enviaremos la
        confirmación a <strong class="text-foreground">{order.email}</strong>.{" "}
        {paid
          ? "Pago recibido."
          : transfer
            ? "Lo prepararemos en cuanto recibamos la transferencia."
            : "El cargo se hace cuando preparamos el envío."}
      </p>

      {transfer && (
        <section
          aria-labelledby="pedido-transferencia"
          class="rounded-md border-2 border-primary bg-card p-4 shadow-sm"
        >
          <h2 id="pedido-transferencia" class="mb-2 text-lg font-semibold">
            Datos para la transferencia
          </h2>
          <p class="mb-3 text-sm">
            Hazla antes del <strong>{transfer.lastDay}</strong> (incluido). Si no la recibimos, el
            pedido se cancelará. También te los hemos enviado por email y los tienes en{" "}
            <a href={`${ORDERS_PATH}${order.id}/`} class="underline underline-offset-4">
              tu pedido
            </a>
            .
          </p>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-muted-foreground">Importe</dt>
            <dd class="font-semibold tabular-nums">{transfer.amount}</dd>
            <dt class="text-muted-foreground">IBAN</dt>
            <dd class="font-mono select-all">{transfer.iban}</dd>
            <dt class="text-muted-foreground">Titular</dt>
            <dd>{transfer.holder}</dd>
            <dt class="text-muted-foreground">Concepto</dt>
            <dd class="font-mono select-all">{transfer.concept}</dd>
          </dl>
        </section>
      )}

      <section
        aria-labelledby="pedido-lineas"
        class="rounded-md border-2 border-line bg-card shadow-sm p-4"
      >
        <h2 id="pedido-lineas" class="mb-3 text-lg font-semibold">
          Productos
        </h2>
        <ul class="divide-y-2 divide-line text-sm">
          {(order.items ?? []).map((item) => (
            <li class="flex justify-between gap-4 py-2">
              <span>
                <span class="tabular-nums">{lineQuantityLabel(item)}</span> {item.product_title}
                {item.variant_title && item.variant_title !== "Única" && (
                  <span class="text-muted-foreground"> · {item.variant_title}</span>
                )}
                {lineDetails(item.metadata).map((d) => (
                  <span class="block text-xs break-words text-muted-foreground">{d}</span>
                ))}
              </span>
              <span class="tabular-nums">
                {formatPrice(item.original_total ?? item.total ?? 0, currency)}
              </span>
            </li>
          ))}
        </ul>
        <OrderTotals
          totals={order}
          currency={currency}
          shippingLabel={`Envío${order.shipping_methods?.[0]?.name ? ` (${order.shipping_methods[0].name})` : ""}`}
        />
      </section>

      {addr && (
        <section
          aria-labelledby="pedido-envio"
          class="rounded-md border-2 border-line bg-card shadow-sm p-4 text-sm"
        >
          <h2 id="pedido-envio" class="mb-2 text-lg font-semibold">
            Dirección de envío
          </h2>
          <address class="not-italic">
            {addr.first_name} {addr.last_name}
            <br />
            {addr.address_1}
            {addr.address_2 && (
              <>
                <br />
                {addr.address_2}
              </>
            )}
            <br />
            {addr.postal_code} {addr.city} ({addr.province})
          </address>
        </section>
      )}
    </div>
  ) : (
    <p class="max-w-2xl text-muted-foreground">
      Hemos recibido tu pedido. Encontrarás todos los detalles en el email de confirmación.
    </p>
  )}
  <a href="/productos/" class:list={[buttonVariants({ variant: "outline" }), "mt-8"]}>
    Seguir comprando
  </a>
</BaseLayout>
