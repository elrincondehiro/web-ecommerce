---
import type { GetStaticPaths } from "astro";
import { PAGE_SIZE } from "$lib/constants";
import { buildListingFacets } from "$lib/facets";
import { facetCategories, productTreeHandles } from "$lib/categories";
import { getListingProducts, getShopTree } from "$lib/shop";
import { breadcrumbJsonLd } from "$lib/seo";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogPage from "../../components/CatalogPage.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const [products, tree] = await Promise.all([getListingProducts(), getShopTree(true)]);
  // Filtro «Categoría» por niveles (Fase S): aquí, las raíces (contando sus subárboles)
  const facets = buildListingFacets(products, {
    categories: facetCategories(tree, []),
    categoryHandles: (p) => productTreeHandles(tree, p),
  });
  return paginate(products, { pageSize: PAGE_SIZE, props: { facets } });
}) satisfies GetStaticPaths;

const { page, facets } = Astro.props;
const crumbs = [
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos/" },
];
const title = page.currentPage > 1 ? `Productos (página ${page.currentPage})` : "Productos";
---

<BaseLayout
  title={title}
  description="Todos los productos de El Rincón de Hiro."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="mb-2 text-2xl font-semibold tracking-tight">Productos</h1>
  <CatalogPage page={page} facets={facets} />
</BaseLayout>
