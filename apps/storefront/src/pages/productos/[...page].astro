---
import type { GetStaticPaths } from "astro";
import { PAGE_SIZE } from "$lib/constants";
import { getAllProducts } from "$lib/medusa";
import { breadcrumbJsonLd } from "$lib/seo";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CatalogPage from "../../components/CatalogPage.astro";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getAllProducts(), { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const crumbs = [
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos/" },
];
const title = page.currentPage > 1 ? `Productos (página ${page.currentPage})` : "Productos";
---

<BaseLayout
  title={title}
  description="Todos los productos de El Rincón de Hiro."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <Breadcrumbs items={crumbs} />
  <h1 class="mb-2 text-2xl font-semibold tracking-tight">Productos</h1>
  <CatalogPage page={page} />
</BaseLayout>
