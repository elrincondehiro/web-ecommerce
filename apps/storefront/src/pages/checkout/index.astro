---
// Checkout (fase 5): on-demand, por usuario, noindex. UNA página con tres pasos (P3):
//   1. #datos  — email, teléfono, dirección de envío (+ facturación)  → action checkout.address
//   2. #envio  — método de envío (opciones de Medusa con su precio)    → action checkout.shipping
//   3. #pago   — Payment Element de Stripe (único JS de la página)
// Pasos 1 y 2 sin JS: <form method="post"> + PRG (middleware → 303 a /checkout/#<paso>). Los
// errores por campo vuelven en la cookie flash (1 min), que aquí se lee y se borra.
// Ver docs/fases/fase5.md §2.
import { PUBLIC_STRIPE_PUBLISHABLE_KEY } from "astro:env/server";
import { buttonVariants } from "$lib/components/ui/button";
import { currentCart } from "$lib/cart-server";
import { itemCount } from "$lib/cart";
import {
  CHECKOUT_NOTICES,
  FLASH_COOKIE,
  addressDone,
  checkoutActionUrl,
  decodeFlash,
  shippingDone,
  stripeSession,
} from "$lib/checkout";
import { formatPrice } from "$lib/format";
import { LOGIN_PATH, REGISTER_PATH, defaultAddress } from "$lib/account";
import {
  POINTS_CONSOLIDATE_DAYS,
  POINTS_PATH,
  POINTS_TERMS_PATH,
  amountInputValue,
  type CartPoints,
} from "$lib/points";
import { isValidId } from "$lib/cart";
import {
  CHECKOUT_FIELDS,
  getCartPoints,
  listShippingOptions,
  retrieveCustomer,
  type StoreCart,
  type StoreCustomer,
  type StoreShippingOption,
} from "$lib/medusa";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AddressFields from "../../components/checkout/AddressFields.astro";
import Field from "../../components/checkout/Field.astro";
import OrderSummary from "../../components/checkout/OrderSummary.astro";
import StripePayment from "../../components/checkout/StripePayment.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const cart: StoreCart | null = await currentCart(Astro.cookies, CHECKOUT_FIELDS);
if (!cart || itemCount(cart) === 0) return Astro.redirect("/carrito/", 303);

const flash = decodeFlash(Astro.cookies.get(FLASH_COOKIE)?.value);
if (Astro.cookies.has(FLASH_COOKIE)) Astro.cookies.delete(FLASH_COOKIE, { path: "/checkout/" });
const errors = flash.errors ?? {};

// Cliente con sesión (fase 9): rellena email y dirección (predeterminada o `?direccion=<id>`) y
// ofrece guardar la dirección en la cuenta. Si el token falla, sigue como invitado.
let customer: StoreCustomer | null = null;
if (Astro.locals.customerToken) {
  try {
    customer = await retrieveCustomer(Astro.locals.customerToken);
  } catch {
    customer = null;
  }
}
const saved = customer?.addresses ?? [];
const pickId = Astro.url.searchParams.get("direccion");
const picked = isValidId(pickId) ? saved.find((a) => a.id === pickId) : undefined;
// Dirección guardada que se propone: la elegida, o la predeterminada si el carrito aún no tiene.
const proposed = picked ?? (cart.shipping_address?.address_1 ? undefined : defaultAddress(saved));

// Valores del formulario: los del flash (tras un error), la dirección guardada propuesta o los
// guardados en el carrito.
const ship = proposed ?? cart.shipping_address;
const bill = proposed ? null : cart.billing_address;
const sameBilling =
  !bill ||
  !ship ||
  (["first_name", "last_name", "address_1", "address_2", "postal_code", "city"] as const).every(
    (k) => (bill[k] ?? "") === (ship[k] ?? ""),
  );
const values: Record<string, string> = flash.values ?? {
  email: cart.email || customer?.email || "",
  phone: ship?.phone ?? "",
  first_name: ship?.first_name ?? "",
  last_name: ship?.last_name ?? "",
  address_1: ship?.address_1 ?? "",
  address_2: ship?.address_2 ?? "",
  postal_code: ship?.postal_code ?? "",
  city: ship?.city ?? "",
  same_billing: sameBilling ? "on" : "",
  billing_first_name: sameBilling ? "" : (bill?.first_name ?? ""),
  billing_last_name: sameBilling ? "" : (bill?.last_name ?? ""),
  billing_address_1: sameBilling ? "" : (bill?.address_1 ?? ""),
  billing_address_2: sameBilling ? "" : (bill?.address_2 ?? ""),
  billing_postal_code: sameBilling ? "" : (bill?.postal_code ?? ""),
  billing_city: sameBilling ? "" : (bill?.city ?? ""),
};
// Tras un POST sin JS la casilla desmarcada no se envía: values.same_billing === "".
const sameBillingChecked = values.same_billing === "on";

const step1 = addressDone(cart);
const step2 = step1 && shippingDone(cart);
let options: StoreShippingOption[] = [];
if (step1) {
  try {
    options = await listShippingOptions(cart.id);
  } catch (err) {
    // Sin datos personales: solo el mensaje de la Store API.
    Astro.logger.error(`checkout opciones de envío: ${err instanceof Error ? err.message : err}`);
  }
}
const selectedOption = cart.shipping_methods?.[0]?.shipping_option_id ?? "";
const session = step2 ? stripeSession(cart) : { state: "none" as const };
const currency = cart.currency_code ?? "eur";

// Puntos (Fase L-3): lo que generaría el pedido y, con sesión, saldo y máximo usable. Las reglas
// las aplica el backend (`GET /store/carts/:id/points`); si falla, el checkout sigue sin puntos.
let points: CartPoints | null = null;
try {
  points = await getCartPoints(cart.id, customer ? (Astro.locals.customerToken ?? null) : null);
} catch (err) {
  Astro.logger.error(`checkout puntos: ${err instanceof Error ? err.message : String(err)}`);
}
const canUsePoints =
  step2 && customer !== null && points !== null && (points.applied > 0 || (points.max ?? 0) > 0);
// Avisos informativos (no errores): se ven en el paso de pago, con otro estilo (Fase P).
const INFO_NOTICES = new Set(["points_adjusted", "points_removed"]);
const infoNotice = flash.code && INFO_NOTICES.has(flash.code) ? CHECKOUT_NOTICES[flash.code] : null;
---

<BaseLayout
  title="Finalizar compra"
  description="Datos de envío y pago de tu pedido en El Rincón de Hiro."
  noindex
  cartCount={itemCount(cart)}
  cartClient={false}
>
  <h1 class="mb-6 text-3xl font-semibold tracking-tight">Finalizar compra</h1>

  {flash.code && !infoNotice && (
    <p
      role="alert"
      class="mb-6 rounded-md border-2 border-destructive px-4 py-3 text-sm text-destructive"
    >
      {CHECKOUT_NOTICES[flash.code]}
    </p>
  )}

  <div class="grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
    <ol class="flex flex-col gap-8">
      {/* ── 1. Datos y dirección ─────────────────────────────────────────────── */}
      <li id="datos" class="scroll-mt-4">
        <section
          aria-labelledby="datos-titulo"
          class="rounded-md border-2 border-line bg-card shadow-sm p-4 sm:p-6"
        >
          <h2 id="datos-titulo" class="mb-4 text-xl font-semibold">
            1. Datos y dirección de envío
          </h2>
          {customer ? (
            saved.length > 1 && (
              <nav aria-label="Mis direcciones" class="mb-4 flex flex-col gap-2 text-sm">
                <span class="font-medium">Usar una dirección guardada:</span>
                <ul class="flex flex-wrap gap-2">
                  {saved.map((a) => (
                    <li>
                      <a
                        href={`?direccion=${a.id}#datos`}
                        aria-current={proposed?.id === a.id ? "true" : undefined}
                        class="block rounded-md border-2 border-line bg-background px-3 py-1.5 hover:bg-muted aria-[current=true]:border-primary aria-[current=true]:bg-muted"
                      >
                        {a.address_name || a.address_1}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          ) : (
            <p class="mb-4 text-sm text-muted-foreground">
              ¿Tienes cuenta?
              <a
                href={`${LOGIN_PATH}?next=${encodeURIComponent("/checkout/")}`}
                class="font-medium underline underline-offset-4"
              >
                Entra
              </a>
              y rellenaremos tus datos.
            </p>
          )}
          <form
            method="post"
            action={checkoutActionUrl("checkout.address")}
            class="checkout-address flex flex-col gap-4"
            novalidate={false}
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <Field
                name="email"
                type="email"
                label="Email"
                autocomplete="email"
                required
                maxlength={254}
                hint="Te enviaremos la confirmación del pedido."
                value={values.email}
                error={errors.email}
              />
              <Field
                name="phone"
                type="tel"
                label="Teléfono"
                autocomplete="shipping tel"
                required
                maxlength={20}
                hint="Para la empresa de transporte."
                value={values.phone}
                error={errors.phone}
              />
            </div>
            <AddressFields prefix="" values={values} errors={errors} />

            <label class="flex items-center gap-2 text-sm">
              <input
                id="misma-direccion"
                type="checkbox"
                name="same_billing"
                checked={sameBillingChecked}
                class="size-4"
              />
              La dirección de facturación es la misma
            </label>
            {/* Visible sin JS cuando se desmarca la casilla (CSS :has en global.css). */}
            <fieldset class="checkout-billing flex flex-col gap-4">
              <legend class="mb-2 font-medium">Dirección de facturación</legend>
              <AddressFields prefix="billing_" values={values} errors={errors} />
            </fieldset>

            {customer && (
              <label class="flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  name="save_address"
                  checked={values.save_address === "on" || saved.length === 0}
                  class="size-4"
                />
                Guardar la dirección de envío en mi cuenta
              </label>
            )}

            <button type="submit" class:list={[buttonVariants(), "self-start"]}>
              {step1 ? "Guardar y continuar" : "Continuar"}
            </button>
          </form>
        </section>
      </li>

      {/* ── 2. Envío ─────────────────────────────────────────────────────────── */}
      {/* Pasos aún no disponibles: borde discontinuo y texto atenuado con --muted-foreground
          (contraste AA). Con `opacity` el texto quedaba en 2,5–3,7:1 (auditoría pre-fase 10). */}
      <li id="envio" class="scroll-mt-4">
        <section
          aria-labelledby="envio-titulo"
          class:list={[
            "rounded-md border-2 border-line p-4 sm:p-6",
            // Paso pendiente: sin fondo ni sombra y con borde discontinuo (aún no disponible).
            step1 ? "bg-card shadow-sm" : "border-dashed text-muted-foreground",
          ]}
        >
          <h2 id="envio-titulo" class="mb-4 text-xl font-semibold">
            2. Envío
          </h2>
          {!step1 ? (
            <p class="text-sm text-muted-foreground">Completa antes tus datos y dirección.</p>
          ) : options.length === 0 ? (
            <p class="text-sm text-destructive">
              No hay métodos de envío disponibles para esta dirección.
            </p>
          ) : (
            <form
              method="post"
              action={checkoutActionUrl("checkout.shipping")}
              class="flex flex-col gap-4"
            >
              <fieldset class="flex flex-col gap-2">
                <legend class="sr-only">Método de envío</legend>
                {options.map((o, i) => (
                  <label class="flex cursor-pointer items-center justify-between gap-4 rounded-md border-2 border-line bg-background p-3 has-checked:border-primary has-checked:bg-muted">
                    <span class="flex items-center gap-3">
                      <input
                        type="radio"
                        name="option_id"
                        value={o.id}
                        required
                        disabled={o.insufficient_inventory}
                        checked={selectedOption ? selectedOption === o.id : i === 0}
                        class="size-4"
                      />
                      {o.name}
                    </span>
                    <span class="tabular-nums">
                      {formatPrice(o.calculated_price?.calculated_amount ?? o.amount, currency)}
                    </span>
                  </label>
                ))}
              </fieldset>
              <button type="submit" class:list={[buttonVariants(), "self-start"]}>
                {step2 ? "Cambiar envío" : "Continuar al pago"}
              </button>
            </form>
          )}
        </section>
      </li>

      {/* ── 3. Pago ──────────────────────────────────────────────────────────── */}
      <li id="pago" class="scroll-mt-4">
        <section
          aria-labelledby="pago-titulo"
          class:list={[
            "rounded-md border-2 border-line p-4 sm:p-6",
            step2 ? "bg-card shadow-sm" : "border-dashed text-muted-foreground",
          ]}
        >
          <h2 id="pago-titulo" class="mb-4 text-xl font-semibold">
            3. Pago
          </h2>
          {infoNotice && (
            <p
              role="status"
              class="mb-4 rounded-md border-2 border-line bg-muted px-4 py-3 text-sm"
              data-checkout-info
            >
              {infoNotice}
            </p>
          )}
          {step2 && (
            <section
              id="codigo"
              aria-labelledby="codigo-titulo"
              class="mb-4 rounded-md border-2 border-line bg-muted/40 p-4"
            >
              <h3 id="codigo-titulo" class="text-base font-semibold">
                Código descuento
              </h3>
              {!customer ? (
                <p class="mt-2 text-sm">
                  <a
                    href={`${LOGIN_PATH}?next=${encodeURIComponent("/checkout/")}`}
                    class="underline underline-offset-4"
                  >
                    Entra en tu cuenta
                  </a>{" "}
                  para usar un código descuento.
                </p>
              ) : points?.code ? (
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                  <p>
                    Código <strong>{points.code}</strong>: −
                    <span class="tabular-nums">{formatPrice(points.code_amount, currency)}</span>
                  </p>
                  <form method="post" action={checkoutActionUrl("checkout.removeCode")}>
                    <button
                      type="submit"
                      class={buttonVariants({ variant: "outline", size: "sm" })}
                    >
                      Quitar
                    </button>
                  </form>
                </div>
              ) : (
                <form
                  method="post"
                  action={checkoutActionUrl("checkout.applyCode")}
                  class="mt-2 flex flex-wrap items-end gap-2 text-sm"
                >
                  <label class="flex flex-col gap-1">
                    Código
                    <input
                      name="code"
                      required
                      autocomplete="off"
                      autocapitalize="characters"
                      spellcheck="false"
                      maxlength="40"
                      class="h-9 w-44 rounded-md border-2 border-line bg-background px-3 uppercase"
                    />
                  </label>
                  <button type="submit" class={buttonVariants({ variant: "outline" })}>
                    Aplicar
                  </button>
                </form>
              )}
              <p class="mt-3 text-xs text-muted-foreground">
                Un código por pedido. Se puede combinar con tus puntos.{" "}
                <a href="/condiciones/#codigos" class="underline underline-offset-4">
                  Condiciones
                </a>
              </p>
            </section>
          )}
          {canUsePoints && points && (
            <section
              id="puntos"
              aria-labelledby="puntos-titulo"
              class="mb-6 rounded-md border-2 border-line bg-muted/40 p-4"
            >
              <h3 id="puntos-titulo" class="text-base font-semibold">
                Usar mis puntos
              </h3>
              {points.applied > 0 ? (
                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                  <p>
                    Usas{" "}
                    <strong class="tabular-nums">{formatPrice(points.applied, currency)}</strong> en
                    puntos en este pedido.
                  </p>
                  <form method="post" action={checkoutActionUrl("checkout.removePoints")}>
                    <button
                      type="submit"
                      class={buttonVariants({ variant: "outline", size: "sm" })}
                    >
                      Quitar
                    </button>
                  </form>
                </div>
              ) : (
                <div class="mt-2 flex flex-col gap-3 text-sm">
                  <p>
                    Tienes{" "}
                    <strong class="tabular-nums">
                      {formatPrice(points.balance ?? 0, currency)} en puntos
                    </strong>
                    .
                    {(points.max ?? 0) < (points.balance ?? 0) &&
                      ` En este pedido puedes usar hasta ${formatPrice(points.max ?? 0, currency)}.`}
                  </p>
                  <form method="post" action={checkoutActionUrl("checkout.applyPoints")}>
                    <input type="hidden" name="amount" value={amountInputValue(points.max ?? 0)} />
                    <button type="submit" class={buttonVariants()}>
                      Usar {formatPrice(points.max ?? 0, currency)}
                    </button>
                  </form>
                  <details>
                    <summary class="cursor-pointer underline underline-offset-4">
                      Usar otro importe
                    </summary>
                    <form
                      method="post"
                      action={checkoutActionUrl("checkout.applyPoints")}
                      class="mt-3 flex flex-wrap items-end gap-2"
                    >
                      <label class="flex flex-col gap-1">
                        Importe en €
                        <input
                          name="amount"
                          required
                          inputmode="decimal"
                          autocomplete="off"
                          pattern="[0-9]{1,6}([.,][0-9]{1,2})?"
                          placeholder={amountInputValue(points.max ?? 0)}
                          class="h-9 w-28 rounded-md border-2 border-line bg-background px-3 tabular-nums"
                        />
                      </label>
                      <button type="submit" class={buttonVariants({ variant: "outline" })}>
                        Aplicar
                      </button>
                    </form>
                  </details>
                </div>
              )}
              <p class="mt-3 text-xs text-muted-foreground">
                Se descuentan del total, IVA incluido.{" "}
                <a href={POINTS_PATH} class="underline underline-offset-4">
                  Ver mis puntos
                </a>
                {" · "}
                <a href={POINTS_TERMS_PATH} class="underline underline-offset-4">
                  Condiciones
                </a>
              </p>
            </section>
          )}
          {!step2 ? (
            <p class="text-sm text-muted-foreground">Elige antes el método de envío.</p>
          ) : !PUBLIC_STRIPE_PUBLISHABLE_KEY ? (
            <p class="text-sm text-destructive">El pago no está disponible en este momento.</p>
          ) : session.state === "pending" ? (
            <div class="flex flex-col gap-4">
              <StripePayment
                publishableKey={PUBLIC_STRIPE_PUBLISHABLE_KEY}
                clientSecret={session.clientSecret}
                total={cart.total ?? 0}
                currency={currency}
              />
              <p class="text-xs text-muted-foreground">
                Al pulsar «Pagar y realizar pedido» aceptas las
                <a href="/condiciones/" class="underline underline-offset-4">
                  condiciones de compra
                </a>
                y confirmas que has leído la
                <a href="/privacidad/" class="underline underline-offset-4">
                  política de privacidad
                </a>
                . El cargo se hace en tu tarjeta cuando preparamos el envío.
              </p>
            </div>
          ) : session.state === "authorized" ? (
            <a href="/checkout/completar/" class={buttonVariants()}>
              Pago autorizado: finalizar el pedido
            </a>
          ) : (
            <form
              method="post"
              action={checkoutActionUrl("checkout.payment")}
              class="flex flex-col gap-3"
            >
              <p class="text-sm text-muted-foreground">
                El total ha cambiado o el formulario de pago ha caducado.
              </p>
              <button type="submit" class:list={[buttonVariants(), "self-start"]}>
                Preparar el pago
              </button>
            </form>
          )}
        </section>
      </li>
    </ol>

    <aside class="lg:sticky lg:top-4">
      <OrderSummary cart={cart}>
        {points && points.earn > 0 && (
          <p class="mt-3 border-t-2 border-line pt-3 text-sm" data-points-earn>
            {customer ? (
              <>
                Con este pedido ganarás{" "}
                <strong class="tabular-nums">{formatPrice(points.earn, currency)} en puntos</strong>
                .
                <span class="mt-1 block text-xs text-muted-foreground">
                  Se suman a tu saldo {POINTS_CONSOLIDATE_DAYS} días después del envío.
                </span>
              </>
            ) : (
              <>
                Con una cuenta ganarías{" "}
                <strong class="tabular-nums">{formatPrice(points.earn, currency)} en puntos</strong>{" "}
                con este pedido.{" "}
                <a href={REGISTER_PATH} class="underline underline-offset-4">
                  Crear cuenta
                </a>
              </>
            )}
          </p>
        )}
      </OrderSummary>
      <a href="/carrito/" class="mt-3 inline-block text-sm underline underline-offset-4">
        Modificar el carrito
      </a>
    </aside>
  </div>
</BaseLayout>
