---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { metaDescription } from "$lib/catalog";
import { getAllProducts } from "$lib/medusa";
import { breadcrumbJsonLd, productJsonLd } from "$lib/seo";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BuyBox from "../../components/BuyBox.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import LiveSync from "../../components/server/LiveSync.astro";

export const getStaticPaths = (async () => {
  const products = await getAllProducts();
  return products.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { product } = Astro.props as Props;
const category = product.categories?.[0];
const crumbs = [
  { name: "Inicio", href: "/" },
  ...(category ? [{ name: category.name, href: `/categorias/${category.handle}/` }] : []),
  { name: product.title, href: `/producto/${product.handle}/` },
];
const gallery = (product.images ?? [])
  .slice()
  .sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
  .map((img) => img.url)
  .filter(Boolean);
if (!gallery.length && product.thumbnail) gallery.push(product.thumbnail);
const image = gallery[0] ?? null;
const options = (product.options ?? []).filter((o) => (o.values?.length ?? 0) > 0);
---

<BaseLayout
  title={product.title}
  description={metaDescription(product.description) || product.title}
  type="product"
  image={image ?? undefined}
  jsonLd={[
    breadcrumbJsonLd(crumbs, Astro.site!),
    productJsonLd(product, Astro.site!, image ?? undefined),
  ]}
>
  <Breadcrumbs items={crumbs} />
  <div class="grid gap-8 md:grid-cols-2">
    <ProductGallery images={gallery} alt={product.title} />
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight">{product.title}</h1>
        {product.subtitle && <p class="text-muted-foreground">{product.subtitle}</p>}
      </div>

      <BuyBox product={product} />

      {options.length > 0 && (
        <dl class="grid gap-2 text-sm">
          {options.map((o) => (
            <div class="flex gap-2">
              <dt class="text-muted-foreground">{o.title}:</dt>
              <dd>{o.values!.map((v) => v.value).join(" · ")}</dd>
            </div>
          ))}
        </dl>
      )}

      {product.description && (
        <section aria-labelledby="descripcion">
          <h2 id="descripcion" class="mb-2 font-semibold">
            Descripción
          </h2>
          <p class="max-w-prose leading-relaxed text-muted-foreground">{product.description}</p>
        </section>
      )}
    </div>
  </div>
  <LiveSync server:defer productId={product.id} />
</BaseLayout>
