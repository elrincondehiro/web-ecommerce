---
// Ficha de producto (Fase DS): aquí solo lo COMÚN (rutas, datos y SEO, `FichaData`); la página la
// pinta el diseño elegido (lib/disenos.ts: el del producto → `diseno_productos` de su categoría
// y de sus padres → estándar; componentes en src/disenos/producto/). Componente elegido con una
// variable (astro-docs, reference/astro-syntax «Dynamic Tags»: sin directivas client:*).
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { analyticRows, isDiscontinued, metaDescription, replacementHandle } from "$lib/catalog";
import { categoryHref, deepestCategory } from "$lib/categories";
import { getCollection } from "astro:content";
import { CORREA_GROUP_HANDLE, CORREA_GROUP_PATH, isCorreaGrouped } from "$lib/correa";
import { PRODUCT_DESIGNS, resolveProductDesign, type ProductDesignId } from "$lib/disenos";
import type { FichaData } from "$lib/ficha";
import { getAllProducts } from "$lib/medusa";
import { getRelatedByProduct, getShopTree } from "$lib/shop";
import { breadcrumbJsonLd, productJsonLd } from "$lib/seo";
import { resolveSizeGuide, resolveTemplate } from "$lib/plantillas";
import { buildVariantPicker, pickerHeadCss } from "$lib/variant-picker";
import Estandar from "../../disenos/producto/Estandar.astro";
import Correa from "../../disenos/producto/Correa.astro";
import Caja from "../../disenos/producto/Caja.astro";

// Registro: id → componente (las propiedades, en lib/disenos.ts). El tipo obliga a tenerlos todos.
const DISENOS: Record<ProductDesignId, typeof Estandar> = {
  estandar: Estandar,
  correa: Correa,
  caja: Caja,
};

// Todas las fichas, también las descatalogadas (Fase E, opción i): su URL sigue respondiendo.
export const getStaticPaths = (async () => {
  const [products, tree] = await Promise.all([getAllProducts(), getShopTree(true)]);
  // /producto/correa-a-medida/ es la página de grupo (E-2c): ningún producto puede usar el handle
  if (products.some((p) => p.handle === CORREA_GROUP_HANDLE)) {
    throw new Error(`El handle «${CORREA_GROUP_HANDLE}» está reservado (página de grupo).`);
  }
  const titles = new Map(products.map((p) => [p.handle, p.title]));
  // Diseño de cada ficha (el build falla si alguno no existe)
  const designs = new Map(
    products.map((p) => [p.id, resolveProductDesign(p, deepestCategory(tree, p)?.path ?? null)]),
  );
  // Hermanos: los demás productos (no descatalogados) con el mismo diseño de producto (no
  // heredable): la correa enlaza sus otros colores y materiales.
  const byDesign = new Map<string, typeof products>();
  for (const p of products) {
    const d = designs.get(p.id)!;
    if (PRODUCT_DESIGNS[d].heredable || isDiscontinued(p)) continue;
    byDesign.set(d, [...(byDesign.get(d) ?? []), p]);
  }
  // Relacionados (Fase R): de la hoja + relleno de su categoría, calculados una vez por build
  const relatedBy = await getRelatedByProduct();
  return products.map((product) => {
    const handle = isDiscontinued(product) ? replacementHandle(product) : null;
    const replacement =
      handle && titles.has(handle) ? { handle, title: titles.get(handle)! } : null;
    const design = designs.get(product.id)!;
    const siblings = byDesign.get(design) ?? [];
    // Descatalogado: su propio enlace al sustituto; sin bloque de relacionados.
    const related = isDiscontinued(product) ? [] : (relatedBy.get(product.id) ?? []);
    return {
      params: { handle: product.handle },
      props: { product, replacement, siblings, related, design },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { product, replacement, siblings, related, design } = Astro.props as Props;
const info = PRODUCT_DESIGNS[design];
const discontinued = isDiscontinued(product);
// Migas: cadena completa de la categoría más concreta del producto (Fase S)
const category = deepestCategory(await getShopTree(true), product);
const crumbs = [
  { name: "Inicio", href: "/" },
  ...(category?.path ?? []).map((c) => ({ name: c.name, href: categoryHref(c) })),
  ...(isCorreaGrouped(product) ? [{ name: "Correa a medida", href: CORREA_GROUP_PATH }] : []),
  { name: product.title, href: `/producto/${product.handle}/` },
];
// Plantilla y guía de tallas (Fase O): el build falla si apuntan a un fichero que no existe.
const guides = info.guias
  ? {
      template: resolveTemplate(
        product,
        category,
        (await getCollection("plantillas")).map((t) => ({
          id: t.id,
          categorias: t.data.categorias,
        })),
      ),
      sizeGuide: resolveSizeGuide(
        product,
        (await getCollection("guias")).map((g) => g.id),
      ),
    }
  : { template: null, sizeGuide: null };
// Selector de opciones (Fase O): con 2 opciones (o 1 con fotos o colores), en vez de la tabla.
const variantPicker = discontinued || !info.selector ? null : buildVariantPicker(product);
const gallery = (product.images ?? [])
  .slice()
  .sort((a, b) => (a.rank ?? 0) - (b.rank ?? 0))
  .map((img) => img.url)
  .filter(Boolean);
if (!gallery.length && product.thumbnail) gallery.push(product.thumbnail);
// Fotos por valor (opción de fotos): grupos en la galería; las generales detrás.
const photoGroups = variantPicker?.a.values.some((v) => v.images.length)
  ? variantPicker.a.values.map((v) => ({ label: v.value, images: v.images }))
  : [];
const generalPhotos = photoGroups.length ? (variantPicker?.generalImages ?? []) : gallery;
const image = photoGroups[variantPicker?.selected.a ?? 0]?.images[0] ?? gallery[0] ?? undefined;
// Descatalogado: enlace al sustituto o, si no hay, a su categoría (o al catálogo)
const onward = replacement
  ? { href: `/producto/${replacement.handle}/`, text: `Ver ${replacement.title}` }
  : category
    ? { href: categoryHref(category), text: `Ver más en ${category.name}` }
    : { href: "/productos/", text: "Ver todos los productos" };

const data: FichaData = {
  product,
  design,
  category,
  crumbs,
  seo: {
    title: product.title,
    description: metaDescription(product.description) || product.title,
    type: "product",
    image,
    noindex: discontinued,
    jsonLd: discontinued
      ? [breadcrumbJsonLd(crumbs, Astro.site!)]
      : [breadcrumbJsonLd(crumbs, Astro.site!), productJsonLd(product, Astro.site!, image)],
  },
  discontinued,
  onward,
  picker: variantPicker ? { picker: variantPicker, headCss: pickerHeadCss(variantPicker) } : null,
  gallery: { general: generalPhotos, groups: photoGroups },
  hasAnalytics: analyticRows(product).length > 0,
  related,
  guides,
  siblings,
};
const Diseno = DISENOS[design];
---

<Diseno {...data} />
