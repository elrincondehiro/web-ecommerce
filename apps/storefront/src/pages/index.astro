---
// Home (I-Interficie; Fase H). Estática (0 JS propio). El hero va siempre el primero; el resto
// de bloques salen de src/content/home.yaml en su `orden` y solo si están (lib/home.ts):
// - categorias (obligatorio): categorías destacadas de cualquier nivel, con su foto propia o la
//   de su primer producto;
// - destacados: carrusel de una Collection, con «Ver los N» a /coleccion/<handle>/;
// - novedades: carrusel de los productos nuevos (últimos N días o etiqueta `novedad`);
// - colecciones: tarjetas a /coleccion/<handle>/;
// - ofertas: banner, solo si hay ofertas en el build;
// - etiquetas: chips «Busca por…» a /buscar/?etiqueta=…;
// - valores.
// Un yaml incoherente (orden repetido, ninguna categoría válida) hace FALLAR el build: nunca se
// publica una home vacía. Precio/stock del carrusel: build + <LiveSync pageKey>.
import { Picture } from "astro:assets";
import { getEntry } from "astro:content";
import { buttonVariants } from "$lib/components/ui/button";
import { getListedProducts, getSaleProductIds } from "$lib/medusa";
import { featuredCategories, orderedBlocks, tagChips } from "$lib/home";
import { emptyParams, searchUrl } from "$lib/search";
import { getFeaturedBlock, getNewBlock, getShopCollections, getShopTree } from "$lib/shop";
import { SITE_NAME } from "$lib/constants";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeCategories from "../components/home/HomeCategories.astro";
import HomeCarousel from "../components/home/HomeCarousel.astro";
import HomeCollections from "../components/home/HomeCollections.astro";
import HomeOffers from "../components/home/HomeOffers.astro";
import HomeTags from "../components/home/HomeTags.astro";
import HomeValues from "../components/home/HomeValues.astro";

const home = (await getEntry("home", "home"))!.data;
const [products, tree, featured, fresh, shopCollections, saleIds] = await Promise.all([
  getListedProducts(),
  getShopTree(true),
  home.destacados ? getFeaturedBlock() : null,
  home.novedades ? getNewBlock() : null,
  home.colecciones ? getShopCollections() : [],
  home.ofertas ? getSaleProductIds() : [],
]);
const blocks = orderedBlocks(home);
const { categories, missing } = featuredCategories(home.categorias.handles, tree.byHandle);
if (missing.length) {
  Astro.logger.warn(`categorías destacadas sin página (se omiten): ${missing.join(", ")}`);
}
// Colecciones de la home: las de home.yaml que tienen página (con productos), en su orden.
const byHandle = new Map(shopCollections.map((c) => [c.collection.handle, c]));
const homeCollections = [...new Set(home.colecciones?.handles ?? [])].flatMap((h) => {
  const c = byHandle.get(h);
  if (!c) Astro.logger.warn(`colección de la home sin productos (se omite): ${h}`);
  return c ? [c] : [];
});
const chips = home.etiquetas ? tagChips(home.etiquetas.valores, products) : [];
const newLink = {
  href: searchUrl({ ...emptyParams(), orden: "novedades" }),
  text: "Ver todas",
};
---

<BaseLayout
  title={SITE_NAME}
  description="El Rincón de Hiro: tienda online especializada en perros (y gatos). Comida y accesorios seleccionados, con envío a toda la península."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE_NAME,
      url: Astro.site?.href,
      inLanguage: "es-ES",
    },
  ]}
>
  {/* Hero: imagen LCP con `priority` (eager + fetchpriority=high, astro-docs). */}
  <section class="mb-14 grid items-center gap-8 md:grid-cols-[1.2fr_1fr]">
    <div class="flex flex-col items-start gap-4">
      <p class="text-sm font-bold tracking-wide text-accent-text uppercase">
        {home.hero.antetitulo}
      </p>
      <h1 class="font-display text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl">
        {home.hero.titulo}
      </h1>
      <p class="max-w-prose text-lg text-muted-foreground">{home.hero.texto}</p>
      <a href={home.hero.cta.enlace} class={buttonVariants({ size: "lg" })}>
        {home.hero.cta.texto}
      </a>
    </div>
    <div class="mx-auto w-full max-w-60 rounded-md md:max-w-sm border-2 border-line bg-[#F3E8DC] p-4 shadow-md">
      <Picture
        src={home.hero.imagen}
        alt={home.hero.imagenAlt}
        widths={[208, 416, 624]}
        sizes="(min-width: 768px) 336px, 208px"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        priority
        class="h-auto w-full"
      />
    </div>
  </section>

  {blocks.map((b) =>
    b === "categorias" ? (
      <HomeCategories titulo={home.categorias.titulo} categories={categories} products={products} />
    ) : b === "destacados" && home.destacados && featured ? (
      <HomeCarousel
        id="home-destacados"
        titulo={home.destacados.titulo}
        products={featured.products}
        link={{
          href: featured.href,
          text:
            featured.total > featured.products.length ? `Ver los ${featured.total}` : "Ver todo",
        }}
      />
    ) : b === "novedades" && home.novedades && fresh ? (
      <HomeCarousel
        id="home-novedades"
        titulo={home.novedades.titulo}
        products={fresh.products}
        link={newLink}
      />
    ) : b === "colecciones" && home.colecciones && homeCollections.length > 0 ? (
      <HomeCollections titulo={home.colecciones.titulo} collections={homeCollections} />
    ) : b === "ofertas" && home.ofertas && saleIds.length > 0 ? (
      <HomeOffers {...home.ofertas} />
    ) : b === "etiquetas" && home.etiquetas && chips.length > 0 ? (
      <HomeTags titulo={home.etiquetas.titulo} chips={chips} />
    ) : b === "valores" && home.valores ? (
      <HomeValues titulo={home.valores.titulo} items={home.valores.items} />
    ) : null,
  )}
</BaseLayout>
