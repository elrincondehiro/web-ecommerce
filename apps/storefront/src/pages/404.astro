---
import { buttonVariants } from "$lib/components/ui/button";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <div class="flex flex-col items-start gap-4 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Página no encontrada</h1>
    <p class="text-muted-foreground">La página que buscas no existe o se ha movido.</p>
    <a href="/" class={buttonVariants()}>
      Volver al inicio
    </a>
  </div>
</BaseLayout>
