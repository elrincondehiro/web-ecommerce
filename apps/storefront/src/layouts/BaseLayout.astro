---
import { Font } from "astro:assets";
import ThemeInit from "../components/ThemeInit.astro";
import Seo from "../components/Seo.astro";
import CartClient from "../components/CartClient.astro";
import SiteClient from "../components/SiteClient.astro";
import CartNotice from "../components/CartNotice.astro";
import AnnouncementBar from "../components/layout/AnnouncementBar.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import "../styles/global.css";

type Props = Parameters<typeof Seo>[0] & {
  /** Páginas on-demand: nº de artículos ya conocido → sin server island. */
  cartCount?: number | undefined;
  /** Script del carrito (fetch, toasts, flyout). /carrito/ no lo necesita (0 JS). */
  cartClient?: boolean | undefined;
};

const { cartCount, cartClient = true, ...seo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3E8DC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#26343C" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-nunito-sans" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-baloo" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
    >
      Saltar al contenido
    </a>
    <AnnouncementBar />
    <SiteHeader cartCount={cartCount} />
    <main id="contenido" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <CartNotice />
      <slot />
    </main>
    <SiteFooter />
    {cartClient && <CartClient />}
    <SiteClient />
  </body>
</html>
