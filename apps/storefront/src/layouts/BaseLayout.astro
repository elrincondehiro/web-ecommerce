---
import { Font } from "astro:assets";
import Seo from "../components/Seo.astro";
import { getCategories } from "$lib/medusa";
import "../styles/global.css";

type Props = Parameters<typeof Seo>[0];

const categories = await getCategories();
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Seo {...Astro.props} />
  </head>
  <body class="flex min-h-dvh flex-col antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
    >
      Saltar al contenido
    </a>
    <header class="border-b">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
        <a href="/" class="text-lg font-semibold tracking-tight">
          El Rincón de Hiro
        </a>
        {/* Menú en UNA línea con scroll horizontal si no cabe: la altura de la cabecera no
            depende de la fuente (con flex-wrap, Inter partía la última categoría a otra línea
            al cargar → CLS 0,33). py-1 deja sitio al anillo de foco dentro del overflow. */}
        <nav aria-label="Categorías" class="max-w-full min-w-0">
          <ul class="-my-1 flex gap-x-4 overflow-x-auto py-1 text-sm whitespace-nowrap [scrollbar-width:none]">
            <li>
              <a
                href="/productos/"
                class="hover:underline"
                aria-current={current.startsWith("/productos/") ? "page" : undefined}
              >
                Todo
              </a>
            </li>
            {categories.map((c) => {
              const href = `/categorias/${c.handle}/`;
              return (
                <li>
                  <a
                    href={href}
                    class="hover:underline aria-[current=page]:font-semibold"
                    aria-current={current.startsWith(href) ? "page" : undefined}
                  >
                    {c.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenido" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>
    <footer class="border-t text-sm text-muted-foreground">
      <div class="mx-auto max-w-6xl px-4 py-6">
        © {new Date().getFullYear()} El Rincón de Hiro · Precios con IVA incluido
      </div>
    </footer>
  </body>
</html>
