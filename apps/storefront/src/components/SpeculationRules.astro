---
// Prefetch de fichas y listados (Fase R-3, P7; src/lib/speculation.ts). JSON inline en el <head>
// con su hash en la CSP (como ThemeInit): las reglas inline cuentan como script para script-src.
import { createHash } from "node:crypto";
import { SPECULATION_RULES } from "$lib/speculation";

const hash = `sha256-${createHash("sha256").update(SPECULATION_RULES).digest("base64")}` as const;
if (import.meta.env.CSP_ENABLED) Astro.csp?.insertScriptHash(hash);
---

<script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
