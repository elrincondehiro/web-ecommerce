---
// Listado paginado: rejilla estática con precio/stock del build + <LiveSync> que los corrige
// (por la clave de la página, D-S1: lib/listing-pages.ts).
import type { Page } from "astro";
import { listingPageKey } from "$lib/listing-pages";
import type { StoreProduct } from "$lib/catalog";
import type { ListingFacets } from "$lib/facets";
import ProductGrid from "./ProductGrid.astro";
import Pagination from "./Pagination.astro";
import LiveSync from "./LiveSync.astro";
import ListingFilters from "./search/ListingFilters.astro";
import CompareButton from "./search/CompareButton.astro";

interface Props {
  page: Page<StoreProduct>;
  /** Facetas del build para el botón "Filtrar" (fase 7-1). */
  facets?: ListingFacets | undefined;
  categoryHandle?: string | undefined;
  /** Fase MK-C: comparador de esta categoría (hoja con datos analíticos), junto a «Filtrar». */
  compareHref?: string | null | undefined;
}
const { page, facets, categoryHandle, compareHref } = Astro.props;
---

{page.total === 0 ? (
  <p class="text-muted-foreground">No hay productos todavía.</p>
) : (
  <>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-muted-foreground">
        {page.total} productos · página {page.currentPage} de {page.lastPage}
      </p>
      <div class="flex flex-wrap items-center gap-2">
        {compareHref && <CompareButton href={compareHref} label="Tabla comparativa" />}
        {facets && <ListingFilters facets={facets} categoria={categoryHandle} />}
      </div>
    </div>
    <ProductGrid products={page.data} priorityCount={2} />
    <Pagination page={page} />
    <LiveSync pageKey={listingPageKey(page.data.map((p) => p.id))} />
  </>
)}
