---
// Listado paginado: rejilla estática con precio/stock del build + <LiveSync> que los corrige.
import type { Page } from "astro";
import type { StoreProduct } from "$lib/catalog";
import ProductGrid from "./ProductGrid.astro";
import Pagination from "./Pagination.astro";
import LiveSync from "./server/LiveSync.astro";

interface Props {
  page: Page<StoreProduct>;
  categoryId?: string | undefined;
}
const { page, categoryId } = Astro.props;
---

{page.total === 0 ? (
  <p class="text-muted-foreground">No hay productos todavía.</p>
) : (
  <>
    <p class="mb-6 text-sm text-muted-foreground">
      {page.total} productos · página {page.currentPage} de {page.lastPage}
    </p>
    <ProductGrid products={page.data} priorityCount={2} />
    <Pagination page={page} />
    <LiveSync server:defer categoryId={categoryId} offset={page.start} limit={page.size} />
  </>
)}
