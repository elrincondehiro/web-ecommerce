---
// Server island de la ficha: precio con IVA, disponibilidad y stock por variante.
// (Añadir al carrito llega en la fase 4.)
import { Badge } from "$lib/components/ui/badge";
import { getProductPricing } from "$lib/catalog";
import { formatPrice } from "$lib/format";
import { getPricedProduct } from "$lib/medusa";

interface Props {
  productId: string;
}
const product = await getPricedProduct(Astro.props.productId);
const pricing = product ? getProductPricing(product) : null;
const multi = (pricing?.variants.length ?? 0) > 1;

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
---

{pricing && pricing.fromAmount != null && pricing.currencyCode ? (
  <div class="flex flex-col gap-4">
    <p class="text-2xl font-semibold">
      {pricing.hasPriceRange && (
        <span class="text-base font-normal text-muted-foreground">Desde </span>
      )}
      {formatPrice(pricing.fromAmount, pricing.currencyCode)}
      <span class="ml-1 text-sm font-normal text-muted-foreground">IVA incluido</span>
    </p>
    <p>
      {pricing.inStock ? (
        <Badge variant="outline">En stock</Badge>
      ) : (
        <Badge variant="secondary">Agotado</Badge>
      )}
    </p>
    {multi && (
      <table class="w-full max-w-sm text-sm">
        <caption class="sr-only">Precio y disponibilidad por variante</caption>
        <thead class="text-left text-muted-foreground">
          <tr>
            <th scope="col" class="py-1 font-normal">
              Variante
            </th>
            <th scope="col" class="py-1 font-normal">
              Precio
            </th>
            <th scope="col" class="py-1 font-normal">
              Disponibilidad
            </th>
          </tr>
        </thead>
        <tbody>
          {pricing.variants.map((v) => (
            <tr class="border-t">
              <th scope="row" class="py-1.5 font-medium">
                {v.title}
              </th>
              <td class="py-1.5">
                {v.amount != null ? formatPrice(v.amount, pricing.currencyCode!) : "—"}
              </td>
              <td class={v.inStock ? "py-1.5" : "py-1.5 text-muted-foreground"}>
                {v.inStock ? "Disponible" : "Agotado"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
) : (
  <p class="text-muted-foreground">Precio no disponible en este momento.</p>
)}
