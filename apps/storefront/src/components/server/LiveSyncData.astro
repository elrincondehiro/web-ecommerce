---
// Server island INVISIBLE (server:defer) con los datos actuales de precio y stock (modo C).
// Solo devuelve un <template data-live-sync> con JSON (inerte, compatible con CSP estricta); lo
// aplica el script estático de <LiveSync>. Usar siempre a través de components/LiveSync.astro.
// Props mínimas para que la URL GET sea corta y cacheable:
//   - listados (categorías, /productos/, /ofertas/, carrusel de la home, página de grupo de la
//     correa): pageKey, clave corta de la página (Fase S, D-S1; lib/listing-pages.ts). El
//     servidor la resuelve a los ids del build con dist/server/listing-pages.json y pide esos
//     productos por id: no repite la consulta del build (con subcategorías u otro orden no daría
//     los mismos) y corrige también una oferta que termina tras el build. No se pasan los ids:
//     irían cifrados en la URL y en el JS inline. Clave desconocida (HTML de otro build) → "{}"
//     → se queda lo del build.
//   - ficha: productId
// Respuesta (perf L-1): en la ficha, producto + todas sus variantes; en los listados, SOLO las
// entradas de producto (las tarjetas no tienen marcas por variante), así su tamaño depende del
// número de tarjetas y no del de variantes. Medusa se consulta con los campos mínimos
// (LIVE_FIELDS en lib/medusa.ts).
// Correa a medida (E-2c): las tarjetas de correa (grupo o color) se piden aparte con solo las
// variantes del largo más corto (lib/correa-server.ts); la ficha de una correa manda el precio
// de cada largo y mosquetón y los datos del configurador (`_correa`, lib/live-sync.ts
// correaLive); la landing (`correaLanding`), la tabla de precios y «hasta X m» por color.
// Sin fallback: si falla o no hay JS, se queda lo del build.
import { correaLive, liveData, liveEntries, surchargeText, type LiveEntry } from "$lib/live-sync";
import {
  cardTablePrices,
  clipPriceKey,
  isCorrea,
  lengthPriceKey,
  maxKey,
  maxText,
  type CorreaLiveData,
} from "$lib/correa";
import { formatPrice } from "$lib/format";
import { cardOf, freshCorreaCards, freshTableVariants, getCorreaCards } from "$lib/correa-server";
import { getCorreaMaxLengths, getPricedProduct, getPricedProductsFresh } from "$lib/medusa";
import { listingIds } from "$lib/shop";

interface Props {
  productId?: string | undefined;
  /** Clave de una página de listado (lib/listing-pages.ts). */
  pageKey?: string | undefined;
  /**
   * Landing de la correa (E-2c): con `pageKey` (las correas de la tabla, una por material),
   * también «hasta X m» / «Agotada» de cada color (ruta de disponibilidad del backend, ~1 KB).
   */
  correaLanding?: boolean | undefined;
}
const { productId, pageKey, correaLanding } = Astro.props;

let entries: LiveEntry[] = [];
let correa: CorreaLiveData | null = null;
if (productId) {
  const product = await getPricedProduct(productId);
  if (product && isCorrea(product)) ({ entries, correa } = correaLive(product));
  else if (product) entries = liveEntries([product]);
} else if (pageKey && correaLanding) {
  // Landing: tabla de precios (las variantes de la tabla de UNA correa por material) +
  // disponibilidad de todos los colores (solo largo máximo). Las dos peticiones en paralelo;
  // si una falla, se queda lo del build de esa parte.
  const ids = await listingIds(pageKey);
  const cards = await getCorreaCards();
  const [table, maxM] = await Promise.all([
    freshTableVariants(ids, cards).catch(() => null),
    getCorreaMaxLengths().catch(() => null),
  ]);
  const fmt = (n: number) => formatPrice(n, "eur");
  const fixed = (id: string, price: string, inStock = true): LiveEntry => ({
    id,
    level: "product",
    inStock,
    price,
  });
  for (const id of table ? ids : []) {
    const card = cards?.members[id];
    if (!card) continue;
    const t = cardTablePrices(card, table!);
    for (const [m, a] of t.lengths) entries.push(fixed(lengthPriceKey(id, m), fmt(a)));
    for (const [c, a] of t.clips) entries.push(fixed(clipPriceKey(id, c), surchargeText(a, fmt)));
  }
  for (const [handle, m] of Object.entries(maxM ?? {})) {
    entries.push(fixed(maxKey(handle), maxText(m), m > 0));
  }
} else if (pageKey) {
  const ids = await listingIds(pageKey);
  const cards = await getCorreaCards();
  const [rest, correas] = await Promise.all([
    getPricedProductsFresh(ids.filter((id) => !cardOf(cards, id))),
    freshCorreaCards(ids, cards),
  ]);
  entries = liveEntries([...rest, ...correas.values()], { variants: false });
}
// Caché compartida corta + SWR (AGENTS.md §3.3); `max-age=30` → el navegador la reutiliza al
// volver atrás/adelante sin pedirla de nuevo.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, s-maxage=60, stale-while-revalidate=300",
);
---

{/* Siempre (aunque sea "{}") para que el observer del aplicador se desconecte. */}
<template data-live-sync set:html={liveData(entries, correa ? { _correa: correa } : undefined)} />
