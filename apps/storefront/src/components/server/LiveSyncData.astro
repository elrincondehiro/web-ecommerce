---
// Server island INVISIBLE (server:defer) con los datos actuales de precio y stock (modo C).
// Solo devuelve un <template data-live-sync> con JSON (inerte, compatible con CSP estricta); lo
// aplica el script estático de <LiveSync>. Usar siempre a través de components/LiveSync.astro.
// Props mínimas para que la URL GET sea corta y cacheable:
//   - listados (categorías, /productos/, /ofertas/, carrusel de la home): pageKey, clave corta
//     de la página (Fase S, D-S1; lib/listing-pages.ts). El servidor la resuelve a los ids del
//     build con dist/server/listing-pages.json y pide esos productos por id: no repite la
//     consulta del build (con subcategorías u otro orden no daría los mismos) y corrige también
//     una oferta que termina tras el build. No se pasan los ids: irían cifrados en la URL y en
//     el JS inline. Clave desconocida (HTML de otro build) → "{}" → se queda lo del build.
//   - ficha: productId
// Sin fallback: si falla o no hay JS, se queda lo del build.
import { liveData, liveEntries } from "$lib/live-sync";
import { getPricedProduct, getPricedProductsFresh } from "$lib/medusa";
import { listingIds } from "$lib/shop";

interface Props {
  productId?: string | undefined;
  /** Clave de una página de listado (lib/listing-pages.ts). */
  pageKey?: string | undefined;
}
const { productId, pageKey } = Astro.props;

const products = productId
  ? [await getPricedProduct(productId)].filter((p) => p !== null)
  : pageKey
    ? await getPricedProductsFresh(await listingIds(pageKey))
    : [];
const entries = liveEntries(products);
// Caché compartida corta + SWR (AGENTS.md §3.3); `max-age=30` → el navegador la reutiliza al
// volver atrás/adelante sin pedirla de nuevo.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, s-maxage=60, stale-while-revalidate=300",
);
---

{/* Siempre (aunque sea "{}") para que el observer del aplicador se desconecte. */}
<template data-live-sync set:html={liveData(entries)} />
