---
// Orden de resultados (GET, sin JS): <select> + botón. Conserva texto y filtros (hidden).
// Sin texto no hay relevancia: la opción por defecto ordena por nombre (lib/search.ts orderFor).
import { buttonVariants } from "$lib/components/ui/button";
import { ANALYTIC_SORTS, SORTS, SORT_LABELS, searchUrl, type SearchParams } from "$lib/search";

interface Props {
  params: SearchParams;
  path: string;
  /** MK-C: ofrecer «Más proteína / grasa (MS)» (hay resultados con datos analíticos). */
  analytic?: boolean;
}
const { params, path, analytic = false } = Astro.props;
// Campos ocultos de la URL canónica de ESTA ruta (en /comparar/ sin `vista`).
const hidden = [
  ...new URLSearchParams(searchUrl({ ...params, pagina: 1 }, path).split("?")[1] ?? ""),
].filter(([k]) => k !== "orden");
const sorts = SORTS.filter((s) => analytic || !ANALYTIC_SORTS.includes(s) || s === params.orden);
---

<form method="get" action={path} class="flex min-w-0 items-center gap-2 text-sm">
  {hidden.map(([name, value]) => (
    <input type="hidden" name={name} value={value} />
  ))}
  <label for="orden" class="sr-only sm:not-sr-only sm:text-muted-foreground">
    {" "}
    Ordenar por{" "}
  </label>
  <select
    id="orden"
    name="orden"
    class="h-8 min-w-0 rounded-md border-2 border-line bg-background px-2"
  >
    {sorts.map((s) => (
      <option value={s} selected={s === params.orden}>
        {s === "relevancia" && !params.q ? "Nombre (A–Z)" : SORT_LABELS[s]}
      </option>
    ))}
  </select>
  <button type="submit" class={buttonVariants({ variant: "outline", size: "sm" })} data-sort-submit>
    Ordenar
  </button>
</form>
