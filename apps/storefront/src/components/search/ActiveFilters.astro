---
// Chips de filtros aplicados (fase 7-1): cada chip es un ENLACE que quita ese filtro, y
// "Quitar todo" vuelve a la búsqueda sin filtros. Deshacer sin "atrás" y sin JS.
// Fase F: la fila existe SIEMPRE con la altura de un chip reservada (`.chip-row`, global.css),
// así aplicar el primer filtro o quitar el último no mueve la rejilla (CLS). Una sola línea con
// scroll horizontal y arrastre con ratón (`data-drag-scroll` + ScrollDrag). Vacía: oculta para
// lectores de pantalla.
import type { ActiveFilter } from "$lib/search";
import ScrollDrag from "../ScrollDrag.astro";

interface Props {
  filters: ActiveFilter[];
  clearHref: string;
}
const { filters, clearHref } = Astro.props;
const empty = filters.length === 0;
---

<div
  class="chip-row mb-4"
  aria-label={empty ? undefined : "Filtros aplicados"}
  role={empty ? undefined : "group"}
  aria-hidden={empty ? "true" : undefined}
  data-drag-scroll
>
  {filters.map((f) => (
    <a
      href={f.href}
      class="inline-flex shrink-0 items-center gap-1 rounded-full border-2 border-line bg-muted px-3 py-1 text-xs whitespace-nowrap hover:bg-background"
      aria-label={`Quitar filtro ${f.label}`}
    >
      {f.label}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="12"
        height="12"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      >
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </a>
  ))}
  {filters.length > 1 && (
    <a
      href={clearHref}
      class="shrink-0 text-xs whitespace-nowrap underline underline-offset-4 hover:no-underline"
    >
      Quitar todo
    </a>
  )}
</div>
<ScrollDrag />
