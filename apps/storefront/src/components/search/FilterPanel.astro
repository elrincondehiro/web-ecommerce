---
// Panel de filtros (fase 7-1). HTML puro, 0 JS:
// - `<form method="get">` con casillas por faceta, precio mín./máx., disponibilidad y "Aplicar".
// - Siempre UN solo panel con `popover` nativo (Baseline 2024; AGENTS §3.1: HTML nativo antes que
//   una isla) y botón "Filtrar". `sidebar`: en ≥ 1024 px el CSS lo muestra fijo como barra lateral
//   y esconde el botón (`.filter-panel--sidebar`, global.css).
// - linkMode (/buscar/, modelo híbrido, fase7.md §2.3.3): valores como enlaces-casilla (sin JS,
//   cada clic navega; con JS los aplica SearchLive en el sitio); solo el precio usa botón.
//   Sin linkMode (categorías estáticas): casillas + "Aplicar filtros" hacia /buscar/.
// Fuente: MDN (context7 /mdn/content: popover, display:none del UA, showPopover), WAI-ARIA
// (role=checkbox); probado en Chromium (fijo en escritorio, Escape no lo oculta, foco y clic ok).
import FilterButton from "./FilterButton.astro";
import { buttonVariants } from "$lib/components/ui/button";
import type { ListingFacets } from "$lib/facets";
import {
  paramEntries,
  searchUrl,
  selectedCount,
  toggleUrl,
  type FixedFilters,
  type SearchParams,
} from "$lib/search";

interface Props {
  facets: ListingFacets;
  params: SearchParams;
  /** Destino del formulario (por defecto /buscar/). */
  action: string;
  /** Filtros fijos de la página (p. ej. la categoría del listado): hidden + sin casilla. */
  fixed?: FixedFilters | undefined;
  /** En ≥ 1024 px, barra lateral fija; debajo, popover. */
  sidebar?: boolean;
  /** Pintar aquí el botón "Filtrar" (false si la página lo coloca aparte: FilterButton). */
  button?: boolean;
  linkMode?: boolean;
  id?: string;
}
const {
  facets,
  params,
  action,
  fixed = {},
  sidebar = false,
  button = true,
  linkMode = false,
  id = "filtros",
} = Astro.props;

const isChecked = (key: "categoria" | "etiqueta" | "opcion", value: string) =>
  params[key].includes(value);
const groups = facets.groups.filter((g) => !(g.key === "categoria" && fixed.categoria));
// Lo que NO se edita en el panel viaja como hidden: texto, orden y filtros fijos.
// En linkMode el formulario solo envía el precio: el resto de filtros viaja oculto.
const hidden = paramEntries(
  { ...params, pagina: 1 },
  linkMode
    ? ["precio_min", "precio_max"]
    : ["categoria", "etiqueta", "opcion", "precio_min", "precio_max", "disponible"],
);
if (fixed.categoria && !hidden.some(([k, v]) => k === "categoria" && v === fixed.categoria)) {
  hidden.push(["categoria", fixed.categoria]);
}
const selected = selectedCount(params, fixed);
const empty = !groups.length && !facets.price && !facets.stockFilter;
const box = "size-4 shrink-0 rounded-sm border border-input accent-primary";
// Ancla del grupo (#f-color): sin JS, la página nueva se abre a la altura del filtro pulsado
// (sin salto al principio). Con JS, SearchLive intercepta el clic y no hay navegación.
const slug = (t: string) =>
  t
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
// Sin JS, "Aplicar" vuelve a la altura de los resultados (solo páginas con #resultados).
const formAction = sidebar ? `${action}#resultados` : action;
const linkHref = (key: "categoria" | "etiqueta" | "opcion", value: string, title: string) =>
  `${toggleUrl(params, key, value, action)}#f-${slug(title)}`;
---

{!empty && (
  <>
    {button && <FilterButton target={id} selected={selected} />}

    <div
      id={id}
      popover="auto"
      class:list={["filter-panel", sidebar && "filter-panel--sidebar"]}
      aria-labelledby={`${id}-titulo`}
      data-filter-panel
    >
      <div class="filter-panel__head flex items-center justify-between border-b px-4 py-3">
        <h2 id={`${id}-titulo`} class="font-semibold">
          Filtrar
        </h2>
        <button
          type="button"
          popovertarget={id}
          popovertargetaction="hide"
          class:list={["rounded-md p-1 hover:bg-muted", sidebar && "lg:hidden"]}
          aria-label="Cerrar filtros"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form method="get" action={formAction} class="flex min-h-0 flex-1 flex-col">
        {hidden.map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <div class="filter-panel__body flex-1 overflow-y-auto px-4 py-2">
          {groups.map((g) => (
            <details
              open
              class="filter-group border-b py-3 last:border-b-0"
              id={`f-${slug(g.title)}`}
            >
              <summary class="cursor-pointer text-sm font-medium">{g.title}</summary>
              <fieldset class="mt-3">
                <legend class="sr-only">{g.title}</legend>
                <ul class="flex flex-col gap-2">
                  {g.values.map((v) => (
                    <li>
                      {linkMode ? (
                        <a
                          href={linkHref(g.key, v.value, g.title)}
                          role="checkbox"
                          aria-checked={isChecked(g.key, v.value) ? "true" : "false"}
                          class="flex items-center gap-2 text-sm hover:underline"
                        >
                          <span class:list={["link-box", box]} aria-hidden="true" />
                          <span class="flex-1">{v.label}</span>
                          {v.count !== undefined && (
                            <span class="text-xs text-muted-foreground tabular-nums">
                              {v.count}
                            </span>
                          )}
                        </a>
                      ) : (
                        <label class="flex cursor-pointer items-center gap-2 text-sm">
                          <input
                            type="checkbox"
                            name={g.key}
                            value={v.value}
                            checked={isChecked(g.key, v.value)}
                            class={box}
                          />
                          <span class="flex-1">{v.label}</span>
                          {v.count !== undefined && (
                            <span class="text-xs text-muted-foreground tabular-nums">
                              {v.count}
                            </span>
                          )}
                        </label>
                      )}
                    </li>
                  ))}
                </ul>
              </fieldset>
            </details>
          ))}

          {facets.price && (
            <fieldset class="border-b py-3">
              <legend class="text-sm font-medium">Precio (€)</legend>
              <div class="mt-3 flex items-center gap-2 text-sm">
                <label class="flex flex-1 flex-col gap-1">
                  <span class="text-xs text-muted-foreground">Mínimo</span>
                  <input
                    type="number"
                    name="precio_min"
                    inputmode="decimal"
                    min="0"
                    step="any"
                    placeholder={String(facets.price.min)}
                    value={params.precioMin ?? undefined}
                    class="h-9 w-full rounded-md border-2 border-line bg-background px-2 tabular-nums"
                  />
                </label>
                <span aria-hidden="true" class="mt-5">
                  –
                </span>
                <label class="flex flex-1 flex-col gap-1">
                  <span class="text-xs text-muted-foreground">Máximo</span>
                  <input
                    type="number"
                    name="precio_max"
                    inputmode="decimal"
                    min="0"
                    step="any"
                    placeholder={String(facets.price.max)}
                    value={params.precioMax ?? undefined}
                    class="h-9 w-full rounded-md border-2 border-line bg-background px-2 tabular-nums"
                  />
                </label>
              </div>
            </fieldset>
          )}

          {facets.stockFilter && linkMode && (
            <div class="py-3" id="f-disponible">
              <a
                href={`${searchUrl({ ...params, disponible: !params.disponible, pagina: 1 }, action)}#f-disponible`}
                role="checkbox"
                aria-checked={params.disponible ? "true" : "false"}
                class="flex items-center gap-2 text-sm hover:underline"
              >
                <span class:list={["link-box", box]} aria-hidden="true" />
                Solo disponibles
              </a>
            </div>
          )}
          {facets.stockFilter && !linkMode && (
            <div class="py-3">
              <label class="flex cursor-pointer items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  name="disponible"
                  value="1"
                  checked={params.disponible}
                  class={box}
                />
                Solo disponibles
              </label>
            </div>
          )}
        </div>

        {(!linkMode || facets.price) && (
          <div class="filter-panel__foot border-t px-4 py-3">
            <button type="submit" class={buttonVariants({ class: "w-full" })}>
              {linkMode ? "Aplicar precio" : "Aplicar filtros"}
            </button>
          </div>
        )}
      </form>
    </div>
  </>
)}
