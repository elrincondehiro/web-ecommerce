---
// Resultados de búsqueda (fase 7-1): cabecera (total + orden + botón de filtros en móvil),
// chips, rejilla y paginación. Mismo ProductCard que el catálogo; precio y stock frescos
// (lib/search-server.ts), así que no hace falta <LiveSync>. Filtros como enlaces-casilla
// (modelo híbrido, fase7.md §2.3.3). Lo pintan /buscar/ y su fragmento /buscar/parcial/.
// Fase MK-C: también /comparar/ (alias de la vista tabla, mismos filtros): `path` es la ruta de
// la página; con datos analíticos, interruptor Tarjetas | Tabla y, en tabla, CompareTable.
import ProductGrid from "../ProductGrid.astro";
import ActiveFilters from "./ActiveFilters.astro";
import FilterButton from "./FilterButton.astro";
import FilterPanel from "./FilterPanel.astro";
import SearchPagination from "./SearchPagination.astro";
import SortForm from "./SortForm.astro";
import ViewToggle from "./ViewToggle.astro";
import CompareTable from "./CompareTable.astro";
import { showCompareToggle } from "$lib/compare";
import type { SearchPage } from "$lib/search-server";
import {
  activeFilters,
  clearFiltersUrl,
  hasFilters,
  searchUrl,
  selectedCount,
  SEARCH_PATH,
  type SearchParams,
} from "$lib/search";

interface Props {
  page: SearchPage;
  params: SearchParams;
  /** Ruta de la página: /buscar/ (por defecto) o /comparar/ (MK-C). */
  path?: string | undefined;
  /** /comparar/: producto marcado de entrada (enlace desde la ficha). */
  checked?: string | undefined;
}
const { page, params, path = SEARCH_PATH, checked } = Astro.props;
const table = params.vista === "tabla";
// Con datos analíticos en TODOS los resultados (no solo en esta página): el rango de proteína
// sobre materia seca de las facetas existe; o en la página (por si el filtro está apagado).
const toggle = table || Boolean(page.facets.ms.proteina) || showCompareToggle(page.products);
// Fase FO: el chip de una familia lleva su nombre («Color: Azul»), del panel o del manifiesto
const familyNames = new Map(
  page.facets.groups
    .filter((g) => g.key === "familia")
    .flatMap((g) => g.values.map((v) => [v.value, v.label] as const)),
);
const chips = activeFilters(params, {
  categoria: (h) => page.categories.get(h) ?? h,
  familia: (key) => familyNames.get(key),
  path,
});
const clearHref = clearFiltersUrl(params, path);
const back = searchUrl(params, path);
const filtersEmpty = !page.facets.groups.length && !page.facets.price && !page.facets.stockFilter;
---

<div class="lg:grid lg:grid-cols-[15rem_1fr] lg:gap-8">
  {/* UN solo panel: popover en móvil, columna lateral fija en ≥ 1024 px (CSS). */}
  <FilterPanel
    facets={page.facets}
    params={params}
    action={path}
    linkMode
    sidebar
    button={false}
    id="filtros"
  />
  <div class="min-w-0 scroll-mt-4" data-results id="resultados">
    {/* min-h-8 (MK-C): la fila mide lo mismo con o sin el interruptor de vista (sin salto). */}
    <div class="mb-4 flex min-h-8 flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-muted-foreground" role="status">
        {page.total === 1 ? "1 producto" : `${page.total} productos`}
        {params.q && <> para «{params.q}»</>}
      </p>
      <div class="flex min-w-0 flex-wrap items-center gap-3">
        {!filtersEmpty && (
          <FilterButton target="filtros" selected={selectedCount(params)} class="lg:hidden" />
        )}
        {toggle && <ViewToggle params={params} />}
        <SortForm params={params} path={path} analytic={toggle} />
      </div>
    </div>
    <ActiveFilters filters={chips} clearHref={clearHref} />

    {page.products.length === 0 ? (
      <div class="rounded-md border-2 border-line px-4 py-10 text-center">
        <p class="font-medium">No hay productos que coincidan.</p>
        <p class="mt-2 text-sm text-muted-foreground">
          {hasFilters(params) ? (
            <>
              Prueba a{" "}
              <a href={clearHref} class="underline underline-offset-4">
                quitar filtros
              </a>{" "}
              o a buscar otra palabra.
            </>
          ) : (
            "Prueba con otra palabra o revisa cómo está escrita."
          )}
        </p>
      </div>
    ) : (
      <>
        {table ? (
          <CompareTable products={page.products} checked={checked} />
        ) : (
          <ProductGrid
            products={page.products}
            priorityCount={2}
            images={page.images}
            back={back}
            families={params.familia}
          />
        )}
        <SearchPagination params={params} total={page.total} path={path} />
      </>
    )}
  </div>
</div>
