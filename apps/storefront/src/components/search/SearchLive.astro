---
// Mejora progresiva de /buscar/ (fase 7-1, modelo híbrido, fase7.md §2.3.3).
// Sin JS: los filtros son enlaces-casilla y cada clic navega (modelo 1, 0 KB).
// Con JS (este bundle, ≤ 1 KB gzip, excepción de AGENTS §3.4): se interceptan los clics en
// enlaces internos (filtros, chips, paginación) y los formularios GET (precio, orden) dentro de
// [data-search-root]; se pide el fragmento (data-partial + query) y se cambia en el sitio:
//   - URL con history.pushState; atrás/adelante (popstate) vuelven a pedir el fragmento;
//   - se conservan el scroll, el panel móvil abierto y el foco del filtro pulsado. Fase D (4.1):
//     el panel (#filtros) NO se sustituye: se cambia su contenido y el de #resultados, así no
//     se cierra ni vuelve a animarse (antes: innerHTML de todo + showPopover → parpadeo). Se
//     mantiene también el scroll de su lista. Si la estructura no coincide, todo el contenedor;
//   - "Ver resultados" (formulario del precio, 4.2) cierra el panel y aplica;
//   - la paginación sube a #resultados; el recuento se anuncia en [data-search-announce];
//   - si algo falla → navegación normal a la URL (lo mismo que sin JS).
// Va como fichero en /_astro/ (astro.config.mjs assetsInlineLimit), no inline. Sin imports.
// Atributos del contenedor: data-path (ruta de la página) y data-partial (URL del fragmento
// terminada en "?" o "&", p. ej. "/buscar/parcial/?").
---

<p class="sr-only" aria-live="polite" data-search-announce></p>

<script>
  const root = document.querySelector<HTMLElement>("[data-search-root]");
  if (root) {
    const path = root.dataset.path!;
    const partial = root.dataset.partial!;
    const announce = document.querySelector("[data-search-announce]")!;
    let ctl: AbortController | undefined;

    // Foco: grupo (#f-…) + texto de la casilla sin el recuento (el href cambia al marcarla).
    const label = (a: Element) => a.textContent!.trim().replace(/\s+\d+$/, "");
    const focusKey = (a: Element) => [a.closest("[id^=f-]")?.id, label(a)];

    const load = async (
      qs: string,
      push: boolean,
      focus?: (string | undefined)[],
      top?: boolean,
    ) => {
      ctl?.abort();
      ctl = new AbortController();
      root.ariaBusy = "true";
      let url = path + (qs && "?" + qs);
      try {
        // El fragmento redirige (301) a su URL canónica: es la que va al historial.
        const res = await fetch(partial + qs, { signal: ctl.signal });
        if (!res.ok) throw 0;
        url = path + new URL(res.url).search;
        const t = document.createElement("template");
        t.innerHTML = await res.text();
        const n = t.content;
        const q = (r: ParentNode, s: string) => r.querySelector<HTMLElement>(s);
        const panel = q(root, "#filtros");
        const results = q(root, "#resultados");
        const np = q(n, "#filtros");
        const nr = q(n, "#resultados");
        if (panel && results && np && nr) {
          const list = q(panel, ".filter-panel__body");
          const y = list?.scrollTop ?? 0;
          panel.replaceChildren(...np.childNodes);
          results.replaceWith(nr);
          const nl = q(panel, ".filter-panel__body");
          if (nl) nl.scrollTop = y;
        } else root.replaceChildren(n);
        if (push) history.pushState(null, "", url);
        if (focus)
          [...root.querySelectorAll<HTMLElement>(`#${focus[0]} [role=checkbox]`)]
            .find((a) => label(a) === focus[1])
            ?.focus();
        if (top) document.getElementById("resultados")?.scrollIntoView();
        announce.textContent = root.querySelector("[role=status]")?.textContent ?? "";
      } catch (e) {
        if ((e as Error).name !== "AbortError") location.href = url;
      }
      root.ariaBusy = null;
    };

    root.addEventListener("click", (e) => {
      const a = (e.target as Element).closest("a");
      if (!a || a.pathname !== path || a.origin !== location.origin) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return; // nueva pestaña
      e.preventDefault();
      const box = a.role === "checkbox";
      void load(a.search.slice(1), true, box ? focusKey(a) : undefined, !!a.rel);
    });
    const submit = (form: HTMLFormElement) => {
      const qs = new URLSearchParams();
      for (const [k, v] of new FormData(form)) if (v) qs.append(k, v as string);
      void load(qs.toString(), true);
    };
    // Formularios GET de la página (precio, orden); los POST (añadir al carrito) no se tocan.
    root.addEventListener("submit", (e) => {
      const form = e.target as HTMLFormElement;
      if (form.method !== "get" || new URL(form.action).pathname !== path) return;
      e.preventDefault();
      form.closest<HTMLElement>(":popover-open")?.hidePopover();
      submit(form);
    });
    // El orden se aplica al elegirlo (el botón "Ordenar" queda para sin JS).
    root.addEventListener("change", (e) => {
      const s = e.target as HTMLSelectElement;
      if (s.name === "orden") submit(s.form!);
    });
    addEventListener("popstate", () => void load(location.search.slice(1), false));
  }
</script>
