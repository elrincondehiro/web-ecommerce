---
// Resumen del pedido en el checkout (fase 5): líneas, envío y total con IVA. HTML de servidor.
// Fase L-3: líneas antes de descuentos y totales en OrderTotals («Puntos −X €»); el slot añade
// debajo lo que se ganaría en puntos.
import { lineQuantityLabel } from "$lib/bulk";
import { formatPrice } from "$lib/format";
import type { StoreCart } from "$lib/medusa";
import { lineDetails } from "$lib/correa";
import OrderTotals from "../order/OrderTotals.astro";

interface Props {
  cart: StoreCart;
}
const { cart } = Astro.props;
const currency = cart.currency_code ?? "eur";
const items = [...(cart.items ?? [])].sort((a, b) =>
  (a.product_title ?? "").localeCompare(b.product_title ?? ""),
);
const hasShipping = (cart.shipping_methods?.length ?? 0) > 0;
---

<section
  aria-labelledby="resumen-titulo"
  class="rounded-md border-2 border-line bg-card shadow-sm p-4"
>
  <h2 id="resumen-titulo" class="mb-3 text-lg font-semibold">
    Resumen
  </h2>
  <ul class="divide-y-2 divide-line text-sm">
    {items.map((item) => (
      <li class="flex justify-between gap-4 py-2">
        <span class="min-w-0">
          <span class="tabular-nums">{lineQuantityLabel(item)}</span> {item.product_title}
          {item.variant_title && item.variant_title !== "Única" && (
            <span class="text-muted-foreground"> · {item.variant_title}</span>
          )}
          {lineDetails(item.metadata).map((d) => (
            <span class="block text-xs break-words text-muted-foreground">{d}</span>
          ))}
        </span>
        <span class="shrink-0 tabular-nums">
          {formatPrice(item.original_total ?? item.total ?? 0, currency)}
        </span>
      </li>
    ))}
  </ul>
  <OrderTotals totals={cart} currency={currency} shippingLabel={hasShipping ? "Envío" : null} />
  <slot />
</section>
