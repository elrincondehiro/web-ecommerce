---
import type { StoreProduct } from "$lib/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: StoreProduct[];
  headingLevel?: 2 | 3 | undefined;
  /** Nº de tarjetas iniciales con imagen prioritaria (LCP). */
  priorityCount?: number | undefined;
}
const { products, headingLevel, priorityCount = 0 } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
  {products.map((product, i) => (
    <li>
      <ProductCard product={product} headingLevel={headingLevel} priority={i < priorityCount} />
    </li>
  ))}
</ul>
