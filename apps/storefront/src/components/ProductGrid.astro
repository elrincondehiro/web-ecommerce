---
import { getProductPricing, type StoreProduct } from "$lib/catalog";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: StoreProduct[];
  /** true en la server island: calcula precio/stock desde variants.calculated_price. */
  priced?: boolean;
  headingLevel?: 2 | 3 | undefined;
}
const { products, priced = false, headingLevel } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
  {products.map((product) => (
    <li>
      <ProductCard
        product={product}
        headingLevel={headingLevel}
        pricing={priced ? getProductPricing(product) : undefined}
      />
    </li>
  ))}
</ul>
