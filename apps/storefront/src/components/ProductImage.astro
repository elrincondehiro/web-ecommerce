---
// Imagen de producto optimizada en build (fase 6): <Picture> AVIF + WebP, cuadrada 1:1 con
// recorte centrado (fit cover), srcset por anchos. Original en SeaweedFS/R2 (IMAGE_BASE_URL);
// Astro la descarga en el build y cachea los derivados en node_modules/.astro (respeta el
// Cache-Control inmutable del bucket). Sin imagen → placeholder SVG local.
// Calidad: valores por defecto de sharp por formato (AVIF 50 · WebP 80), sin `quality`.
// Fuente: astro-docs (guides/images: Picture, widths/sizes, fit/position, asset caching).
import { Picture } from "astro:assets";
import placeholder from "../assets/placeholder.svg";
import {
  IMAGE_FALLBACK_FORMAT,
  IMAGE_FORMATS,
  IMAGE_PRESETS,
  type CardImage,
  type ImageVariant,
} from "$lib/images";

interface Props {
  src?: string | null | undefined;
  alt: string;
  variant?: ImageVariant;
  /** Imagen LCP: carga inmediata y alta prioridad. */
  priority?: boolean;
  class?: string;
  /**
   * Páginas on-demand (/buscar/, D6): miniatura ya generada en el build, o `null` si no la hay
   * (producto posterior al build) → placeholder. Nunca <Picture> (sharp en runtime).
   */
  prebuilt?: CardImage | null | undefined;
  /** `sizes` propio (p. ej. el carrusel); por defecto, el del preset. Mismos ficheros. */
  sizes?: string | undefined;
}
const {
  src,
  alt,
  variant = "card",
  priority = false,
  class: className = "",
  prebuilt,
  sizes: sizesProp,
} = Astro.props;
const preset = IMAGE_PRESETS[variant];
const sizes = sizesProp ?? preset.sizes;
const classes = `aspect-square w-full bg-muted object-cover ${className}`;
const loading = priority ? "eager" : "lazy";
---

{prebuilt ? (
  <picture>
    {prebuilt.sources.map((s) => (
      <source srcset={s.srcset} type={s.type} sizes={sizes} />
    ))}
    <img
      src={prebuilt.src}
      srcset={prebuilt.srcset}
      sizes={sizes}
      alt={alt}
      width={preset.width}
      height={preset.width}
      loading={loading}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      class={classes}
    />
  </picture>
) : src && prebuilt === undefined ? (
  <Picture
    src={src}
    alt={alt}
    width={preset.width}
    height={preset.width}
    widths={preset.widths}
    sizes={sizes}
    formats={[...IMAGE_FORMATS]}
    fallbackFormat={IMAGE_FALLBACK_FORMAT}
    fit="cover"
    position="center"
    loading={loading}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={classes}
  />
) : (
  <img
    src={placeholder.src}
    alt=""
    width={preset.width}
    height={preset.width}
    loading={loading}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={classes}
  />
)}
