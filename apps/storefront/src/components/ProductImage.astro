---
// Imagen de tarjeta. Mismo HTML en el fallback estático y en la server island, para que el
// navegador no la descargue dos veces. Por eso usa <img> con la URL original y no <Image>:
// <Image> genera /_astro/* en build y /_image?… en runtime (URLs distintas). Las imágenes
// del catálogo pasarán por el CDN/R2 en la fase 6. El placeholder es un SVG local.
import placeholder from "../assets/placeholder.svg";

interface Props {
  src?: string | null | undefined;
  alt: string;
  size?: number;
}
const { src, alt, size = 600 } = Astro.props;
---

<img
  src={src || placeholder.src}
  alt={src ? alt : ""}
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
  class="aspect-square w-full rounded-md bg-muted object-cover"
/>
