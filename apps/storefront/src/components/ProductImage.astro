---
// Imagen de producto optimizada en build (fase 6): <Picture> AVIF + WebP, cuadrada 1:1 con
// recorte centrado (fit cover), srcset por anchos. Original en SeaweedFS/R2 (IMAGE_BASE_URL);
// Astro la descarga en el build y cachea los derivados en node_modules/.astro (respeta el
// Cache-Control inmutable del bucket). Sin imagen → placeholder SVG local.
// Calidad: valores por defecto de sharp por formato (AVIF 50 · WebP 80), sin `quality`.
// Fuente: astro-docs (guides/images: Picture, widths/sizes, fit/position, asset caching).
import { Picture } from "astro:assets";
import placeholder from "../assets/placeholder.svg";

export type ImageVariant = "card" | "detail" | "thumb";

const PRESETS: Record<ImageVariant, { width: number; widths: number[]; sizes: string }> = {
  // Rejilla: 2 cols (móvil) · 3 (sm) · 4 (lg, contenedor max-w-6xl = 1152px)
  card: {
    width: 640,
    widths: [320, 480, 640],
    sizes: "(min-width: 1024px) 270px, (min-width: 640px) 33vw, 50vw",
  },
  // Ficha: 1 col (móvil, ancho − px-4·2) · 2 cols con gap-8 (md) · máx. 544px (max-w-6xl).
  // 800 cubre el móvil típico (≈380px CSS × DPR 1,75–2 ≈ 665–760px) sin saltar a 960.
  detail: {
    width: 1200,
    widths: [640, 800, 960, 1200],
    sizes: "(min-width: 1152px) 544px, (min-width: 768px) calc(50vw - 2rem), calc(100vw - 2rem)",
  },
  // Miniaturas de la galería
  thumb: { width: 160, widths: [80, 160], sizes: "80px" },
};

interface Props {
  src?: string | null | undefined;
  alt: string;
  variant?: ImageVariant;
  /** Imagen LCP: carga inmediata y alta prioridad. */
  priority?: boolean;
  class?: string;
}
const { src, alt, variant = "card", priority = false, class: className = "" } = Astro.props;
const preset = PRESETS[variant];
const classes = `aspect-square w-full bg-muted object-cover ${className}`;
const loading = priority ? "eager" : "lazy";
---

{src ? (
  <Picture
    src={src}
    alt={alt}
    width={preset.width}
    height={preset.width}
    widths={preset.widths}
    sizes={preset.sizes}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    fit="cover"
    position="center"
    loading={loading}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={classes}
  />
) : (
  <img
    src={placeholder.src}
    alt=""
    width={preset.width}
    height={preset.width}
    loading={loading}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={classes}
  />
)}
