---
// Cabecera de una página de colección (Fase H): título y, si la colección los tiene, la foto y
// la descripción propias (metadata, widget del Admin). Estática, 0 JS.
// - Foto panorámica 3:1 (16:9 en móvil) recortada al centro: es la LCP de la página → carga
//   inmediata y prioridad alta (AGENTS §3.3). <Picture> AVIF/WebP en el build, como las de
//   producto (mismo origen: el bucket, image.remotePatterns).
// Fuente: astro-docs (guides/images: Picture, widths/sizes, fit/position).
import { Picture } from "astro:assets";
import { IMAGE_FALLBACK_FORMAT, IMAGE_FORMATS } from "$lib/images";
import type { EntityImage } from "$lib/entity-image";

interface Props {
  title: string;
  description?: string;
  image?: EntityImage | null;
}
const { title, description = "", image = null } = Astro.props;
---

<header class="mb-6">
  {image && (
    <Picture
      src={image.src}
      alt={image.alt}
      width={1200}
      height={400}
      widths={[640, 960, 1200]}
      sizes="(min-width: 1152px) 1120px, calc(100vw - 2rem)"
      formats={[...IMAGE_FORMATS]}
      fallbackFormat={IMAGE_FALLBACK_FORMAT}
      fit="cover"
      position="center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="mb-4 aspect-video w-full rounded-md border-2 border-line bg-muted object-cover shadow-sm sm:aspect-[3/1]"
    />
  )}
  <h1 class="mb-2 text-2xl font-semibold tracking-tight">{title}</h1>
  {description && <p class="max-w-prose text-muted-foreground">{description}</p>}
</header>
