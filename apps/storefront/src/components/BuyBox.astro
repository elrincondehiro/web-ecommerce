---
// Precio con IVA, disponibilidad y stock por variante (HTML estático del build).
// <LiveSync productId> los corrige en runtime (data-pid/data-price/data-vstock, lib/live-sync.ts).
// Añadir al carrito (fase 4): <AddToCart> con la variante (hidden si hay una; radios en la tabla
// si hay varias) y la cantidad. Los radios de variantes agotadas se ocultan con data-if-vstock.
// Precio por kilo/litro (S-2, RD 3423/2000): junto al precio con una variante; con varias, en
// cada fila de la tabla (el «Desde» no lo lleva: sería el de otra variante).
// Granel (S-3): «Desde» = precio del mínimo, €/kg debajo, campo de gramos (AddToCart `bulk`) y,
// con CATALOG_FEATURES.bulkStockLeft, «Quedan 2,4 kg» ([data-left], lo corrige LiveSync).
import { Badge } from "$lib/components/ui/badge";
import AddToCart from "./AddToCart.astro";
import { commonRule, formatGrams } from "$lib/bulk";
import { discountPercent, getProductPricing, minimumNote, type StoreProduct } from "$lib/catalog";
import { stockLeftText } from "$lib/live-sync";
import Price from "./Price.astro";

interface Props {
  product: StoreProduct;
}
const { product } = Astro.props;
const pricing = getProductPricing(product);
const multi = pricing.variants.length > 1;
const currency = pricing.currencyCode;
const back = `/producto/${product.handle}/`;
// Preselección: la primera variante con stock (en el build) o, si no hay, la primera.
const preselected = (pricing.variants.find((v) => v.inStock) ?? pricing.variants[0])?.id;
const bulk = pricing.isBulk
  ? commonRule(pricing.variants.flatMap((v) => (v.bulk ? [v.bulk] : [])))
  : null;
const single = multi ? undefined : pricing.variants[0];
const bulkNote = minimumNote(pricing);
const singleLeft = single ? stockLeftText(single) : null;
---

{pricing.fromAmount != null && currency ? (
  <div
    class="flex flex-col gap-4"
    data-pid={product.id}
    data-stock={pricing.inStock ? "in" : "out"}
  >
    <p class="flex flex-wrap items-baseline gap-x-2">
      <Price
        id={product.id}
        amount={pricing.fromAmount}
        currency={currency}
        wasAmount={pricing.wasAmount}
        discountPercent={pricing.discountPercent}
        from={pricing.hasPriceRange}
        size="lg"
        unit={multi ? null : pricing.unitPrice}
        unitNote={multi ? null : bulkNote}
      />
      <span class="text-sm text-muted-foreground">IVA incluido</span>
    </p>
    <p>
      <Badge variant="outline" data-if-stock="in">
        En stock
      </Badge>
      <Badge variant="secondary" data-if-stock="out">
        Agotado
      </Badge>
      {singleLeft && single && (
        <span class="ml-2 text-sm text-muted-foreground" data-if-stock="in" data-left={single.id}>
          {singleLeft}
        </span>
      )}
    </p>
    <AddToCart
      back={back}
      productId={product.id}
      productTitle={product.title}
      variantId={multi ? undefined : pricing.variants[0]?.id}
      size="lg"
      class="flex flex-col gap-4"
      bulk={bulk}
      unitKey={multi ? "" : product.id}
    >
      {multi && (
        <fieldset slot="before">
          <legend class="sr-only">Elige una variante</legend>
          <table class="w-full max-w-sm text-sm tabular-nums">
            <caption class="sr-only">Precio y disponibilidad por variante</caption>
            <thead class="text-left text-muted-foreground">
              <tr>
                <th scope="col" class="w-8 py-1 font-normal">
                  <span class="sr-only">Elegir</span>
                </th>
                <th scope="col" class="py-1 font-normal">
                  Variante
                </th>
                <th scope="col" class="py-1 font-normal">
                  Precio
                </th>
                <th scope="col" class="py-1 font-normal">
                  Disponibilidad
                </th>
              </tr>
            </thead>
            <tbody>
              {pricing.variants.map((v) => (
                <tr
                  class="variant-row border-t"
                  data-pid={v.id}
                  data-vstock={v.inStock ? "in" : "out"}
                >
                  <td class="py-1.5">
                    <input
                      type="radio"
                      name="variant_id"
                      value={v.id}
                      id={`v-${v.id}`}
                      checked={v.id === preselected}
                      required
                      data-if-vstock="in"
                      class="size-4 accent-primary"
                    />
                  </td>
                  <th scope="row" class="py-1.5 font-medium">
                    <label for={`v-${v.id}`}>{v.title}</label>
                  </th>
                  <td class="py-1.5">
                    {v.amount != null ? (
                      <Price
                        id={v.id}
                        amount={v.amount}
                        currency={currency}
                        wasAmount={v.wasAmount}
                        discountPercent={
                          v.wasAmount !== null ? discountPercent(v.amount, v.wasAmount) : null
                        }
                        unit={v.unitPrice}
                        unitNote={v.bulk ? `mínimo ${formatGrams(v.bulk.minG)}` : null}
                      />
                    ) : (
                      "—"
                    )}
                  </td>
                  <td class="py-1.5">
                    <span data-if-vstock="in" data-left={stockLeftText(v) ? v.id : undefined}>
                      {stockLeftText(v) ?? "Disponible"}
                    </span>
                    <span class="text-muted-foreground" data-if-vstock="out">
                      Agotado
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </fieldset>
      )}
    </AddToCart>
  </div>
) : (
  <p class="text-muted-foreground">Precio no disponible en este momento.</p>
)}
