---
// Galería de la ficha sin JS: carrusel con scroll-snap + miniaturas que son anclas (#foto-N).
// La primera foto es la imagen LCP (priority). Con una sola foto no hay miniaturas.
// Fase D (1.6): marco y sombra retro. Una foto por vista; cada una 4px más estrecha que el
// carrusel para que su sombra (3px) no la recorte el scroll.
import ProductImage from "./ProductImage.astro";
import ScrollDrag from "./ScrollDrag.astro";

interface Props {
  images: string[];
  alt: string;
}
const { images, alt } = Astro.props;
const many = images.length > 1;
const frame = "rounded-md border-2 border-line shadow-sm";
---

<div class="flex flex-col gap-3">
  {images.length === 0 ? (
    <ProductImage alt="" variant="detail" priority class={frame} />
  ) : (
    <ul
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-1 [scrollbar-width:none]"
      aria-label={many ? `Fotos de ${alt}` : undefined}
      data-drag-scroll={many ? "" : undefined}
    >
      {images.map((src, i) => (
        <li id={`foto-${i + 1}`} class="w-[calc(100%-0.25rem)] shrink-0 snap-start">
          <ProductImage
            src={src}
            alt={many ? `${alt} — foto ${i + 1} de ${images.length}` : alt}
            variant="detail"
            priority={i === 0}
            class={frame}
          />
        </li>
      ))}
    </ul>
  )}
  {many && (
    <nav aria-label="Elegir foto">
      <ul class="flex gap-2 overflow-x-auto pr-1 pb-1">
        {images.map((src, i) => (
          <li class="w-16 shrink-0 sm:w-20">
            <a
              href={`#foto-${i + 1}`}
              class="block overflow-hidden rounded-md border-2 border-line shadow-xs focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              aria-label={`Ver foto ${i + 1}`}
            >
              <ProductImage src={src} alt="" variant="thumb" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</div>
{many && <ScrollDrag />}
