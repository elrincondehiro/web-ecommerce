---
// Galería de la ficha sin JS: carrusel con scroll-snap + miniaturas que son anclas (#foto-N).
// La primera foto es la imagen LCP (priority). Con una sola foto no hay miniaturas.
// Fase D (1.6): marco y sombra retro. Una foto por vista; cada una 4px más estrecha que el
// carrusel para que su sombra (3px) no la recorte el scroll.
// Fase O: `groups` = fotos de cada valor de la opción de fotos (selector de opciones), en orden
// de posición. Cada foto lleva `data-pa` y el CSS del selector (dentro de `.vp`) deja ver solo
// las del valor elegido; las generales (`images`) salen siempre, detrás. Las ocultas no se
// descargan (lazy + display:none); la LCP es la primera del valor preseleccionado (`selected`).
import ProductImage from "./ProductImage.astro";
import ScrollDrag from "./ScrollDrag.astro";

interface Props {
  images: string[];
  alt: string;
  groups?: { label: string; images: string[] }[] | undefined;
  /** Índice del grupo preseleccionado. */
  selected?: number | undefined;
}
const { images, alt, groups = [], selected = 0 } = Astro.props;
interface Shot {
  src: string;
  id: string;
  pa?: number | undefined;
  alt: string;
  /** Nombre del enlace de su miniatura. */
  label: string;
  priority: boolean;
}
const shots: Shot[] = [];
groups.forEach((g, gi) => {
  g.images.forEach((src, i) => {
    shots.push({
      src,
      id: `foto-${gi + 1}-${i + 1}`,
      pa: gi + 1,
      alt: `${alt} — ${g.label}, foto ${i + 1} de ${g.images.length}`,
      label: `Ver foto ${i + 1} de ${g.label}`,
      priority: gi === selected && i === 0,
    });
  });
});
const leadIsGroup = (groups[selected]?.images.length ?? 0) > 0;
images.forEach((src, i) => {
  shots.push({
    src,
    id: `foto-${i + 1}`,
    alt: groups.length
      ? `${alt} — foto general ${i + 1}`
      : `${alt} — foto ${i + 1} de ${images.length}`,
    label: groups.length ? `Ver foto general ${i + 1}` : `Ver foto ${i + 1}`,
    priority: !leadIsGroup && i === 0,
  });
});
// Fotos visibles a la vez: las del grupo más grande + las generales
const visible = Math.max(0, ...groups.map((g) => g.images.length)) + images.length;
const many = visible > 1;
const frame = "rounded-md border-2 border-line shadow-sm";
---

<div class="flex flex-col gap-3">
  {shots.length === 0 ? (
    <ProductImage alt="" variant="detail" priority class={frame} />
  ) : (
    <ul
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-1 [scrollbar-width:none]"
      aria-label={many ? `Fotos de ${alt}` : undefined}
      data-drag-scroll={many ? "" : undefined}
    >
      {shots.map((s) => (
        <li id={s.id} class="w-[calc(100%-0.25rem)] shrink-0 snap-start" data-pa={s.pa}>
          <ProductImage
            src={s.src}
            alt={many ? s.alt : alt}
            variant="detail"
            priority={s.priority}
            low={!s.priority}
            class={frame}
          />
        </li>
      ))}
    </ul>
  )}
  {many && (
    <nav aria-label="Elegir foto">
      <ul class="flex gap-2 overflow-x-auto pr-1 pb-1">
        {shots.map((s) => (
          <li class="w-16 shrink-0 sm:w-20" data-pa={s.pa}>
            <a
              href={`#${s.id}`}
              class="block overflow-hidden rounded-md border-2 border-line shadow-xs focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              aria-label={s.label}
            >
              <ProductImage src={s.src} alt="" variant="thumb" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</div>
{many && <ScrollDrag />}
