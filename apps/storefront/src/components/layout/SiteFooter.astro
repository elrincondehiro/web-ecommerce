---
// Pie de 4 columnas (I-Interficie): contacto, redes, información/legal y métodos de pago, con
// el logo. HTML estático, 0 JS. Datos en src/content/tienda.yaml.
// Logo: fichero de public/ (el pie también está en páginas on-demand: sin sharp en runtime, D6).
// En oscuro va en un recuadro crema (no hay logo en negativo, I-Marca).
// Pagos (D8): logos oficiales de Visa/Mastercard/AMEX (public/pagos/LICENSE.md). La
// transferencia no se muestra hasta que exista (D9).
import { getEntry } from "astro:content";
import Icon from "../Icon.astro";
import { OFFERS_PATH, SITE_NAME } from "$lib/constants";

const tienda = (await getEntry("tienda", "tienda"))!.data;
const tel = tienda.telefono.replace(/\D/g, "");
const telFmt = tel.replace(/(\d{3})(\d{3})(\d{3})/, "$1 $2 $3");
const info = [
  { href: "/sobre-nosotros/", name: "Sobre nosotros" },
  { href: OFFERS_PATH, name: "Ofertas" },
  { href: "/condiciones/", name: "Condiciones" },
  { href: "/privacidad/", name: "Privacidad" },
  { href: "/cookies/", name: "Cookies" },
  { href: "/aviso-legal/", name: "Aviso legal" },
];
const pagos = [
  { src: "/pagos/visa.svg", alt: "Visa" },
  { src: "/pagos/mastercard.svg", alt: "Mastercard" },
  { src: "/pagos/amex.svg", alt: "American Express" },
];
const heading = "mb-3 font-display text-base font-bold text-foreground";
const link = "hover:text-foreground hover:underline";
---

<footer class="mt-12 border-t-2 border-line bg-muted text-sm text-muted-foreground">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr]">
    <section aria-labelledby="pie-contacto">
      <a
        href="/"
        class="mb-4 inline-block rounded-md dark:border-2 dark:border-line dark:bg-[#F3E8DC] dark:p-1"
      >
        <img
          src="/logo-pie.webp"
          alt={SITE_NAME}
          width="120"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </a>
      <h2 id="pie-contacto" class={heading}>
        Contacto
      </h2>
      <address class="flex flex-col gap-2 not-italic">
        <a href={`mailto:${tienda.email}`} class:list={[link, "inline-flex items-center gap-2"]}>
          <Icon name="envelope" class="size-5 shrink-0" />
          {tienda.email}
        </a>
        <a href={`tel:+34${tel}`} class:list={[link, "inline-flex items-center gap-2"]}>
          <Icon name="phone" class="size-5 shrink-0" />
          {telFmt}
        </a>
        <span class="inline-flex items-start gap-2">
          <Icon name="map-pin" class="size-5 shrink-0" />
          <span>
            {tienda.direccion.calle}
            <br />
            {tienda.direccion.cp} {tienda.direccion.ciudad}
          </span>
        </span>
      </address>
    </section>

    <section aria-labelledby="pie-redes">
      <h2 id="pie-redes" class={heading}>
        Síguenos
      </h2>
      <ul class="flex flex-col gap-2">
        {tienda.redes.map((r) => (
          <li>
            <a href={r.url} rel="noopener" class:list={[link, "inline-flex items-center gap-2"]}>
              <Icon name={r.red} class="size-5 shrink-0" />
              {r.nombre}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <nav aria-labelledby="pie-info">
      <h2 id="pie-info" class={heading}>
        Información
      </h2>
      <ul class="flex flex-col gap-2">
        {info.map((l) => (
          <li>
            <a href={l.href} class={link}>
              {l.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section aria-labelledby="pie-pago">
      <h2 id="pie-pago" class={heading}>
        Pago seguro
      </h2>
      <ul class="flex flex-wrap gap-2">
        {pagos.map((p) => (
          <li>
            <img src={p.src} alt={p.alt} width="48" height="30" loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
      <p class="mt-3">Pago con tarjeta procesado por Stripe.</p>
    </section>
  </div>
  <div class="border-t border-line/20">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs">
      © {new Date().getFullYear()} {SITE_NAME} · Precios con IVA incluido
    </p>
  </div>
</footer>
