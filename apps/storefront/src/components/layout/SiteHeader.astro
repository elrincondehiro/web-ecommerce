---
// Cabecera (I-Interficie). HTML estático; los menús son `popover` nativos (sin JS, D2):
//   - Escritorio (≥ lg): Tienda ▾ (popover anclado a su botón: una columna por categoría raíz con
//     sus hijas; el 3.er nivel, en la página de cada categoría — Fase S), Ofertas, Sobre
//     nosotros; búsqueda; tema; carrito.
//   - Móvil: ☰ (popover lateral con todo el menú; un <details> por raíz) · logo · tema ·
//     carrito; búsqueda en la 2.ª fila.
// `popover="auto"` se cierra al pulsar fuera y con Escape; el botón lleva `popovertarget` (el
// navegador gestiona aria-expanded y devuelve el foco). Fuente: MDN (Popover API, anchor
// positioning: el invocador es el ancla implícita).
// Ocultar al bajar / mostrar al subir (D1): `data-hide` lo pone SiteClient; sin JS, la cabecera
// es fija (sticky) y siempre visible. Fase L-1: en móvil, al bajar queda visible SOLO la búsqueda
// (su fila); en escritorio la cabecera no se esconde. CSS en global.css (.site-header).
// "Mi cuenta" (fase 9): enlace FIJO a /cuenta/ (igual para todos: la cabecera sigue estática y
// cacheable). Sin sesión, /cuenta/ redirige a "Entrar".
// Fase L-1: ♡ a la lista de deseos (sin sesión, /cuenta/deseos/ manda a «Entrar»). Estado por
// usuario (icono de cuenta relleno con sesión, ♡ relleno si hay algo guardado): en páginas
// estáticas lo trae la island HeaderState (con el contador del carrito) y lo aplica CartClient
// (`<html data-auth / data-wish-any>`, CSS en global.css); en carrito/checkout/pedido (on-demand,
// sin CartClient) sale del servidor. En móvil el selector de tema va en el menú (no cabía).
import Icon from "../Icon.astro";
import HeartFilled from "../HeartFilled.astro";
import CartCountBadge from "../CartCountBadge.astro";
import HeaderState from "../server/HeaderState.astro";
import { WISHLIST_PATH } from "$lib/wishlist";
import { listWishlist } from "$lib/medusa";
import { CART_PATH } from "$lib/cart";
import { categoryHref } from "$lib/categories";
import { getShopTree } from "$lib/shop";
import { SEARCH_PATH } from "$lib/search";
import { OFFERS_PATH } from "$lib/constants";
import { ACCOUNT_PATH } from "$lib/account";

interface Props {
  cartCount?: number | undefined;
}
const { cartCount } = Astro.props;
// Árbol sin categorías vacías: del build en páginas estáticas; del manifiesto en on-demand.
const tree = await getShopTree(Astro.isPrerendered);
const current = Astro.url.pathname;
const q = current === SEARCH_PATH ? (Astro.url.searchParams.get("q") ?? "") : "";
const inShop =
  current.startsWith("/productos/") ||
  current.startsWith("/categoria/") ||
  current.startsWith("/producto/");
const allLink = { href: "/productos/", name: "Todos los productos" };
const shopGroups = tree.roots.map((r) => ({
  href: categoryHref(r),
  name: r.name,
  children: r.children.map((c) => ({ href: categoryHref(c), name: c.name })),
}));
const mainLinks = [
  { href: OFFERS_PATH, name: "Ofertas" },
  { href: "/sobre-nosotros/", name: "Sobre nosotros" },
];
const aria = (href: string) => (current.startsWith(href) ? "page" : undefined);
const iconBtn = "header-hover inline-flex size-10 items-center justify-center rounded-md";
// Páginas on-demand con el carrito ya calculado (sin island ni CartClient): estado del servidor.
const token = Astro.isPrerendered ? null : Astro.locals.customerToken;
const server =
  cartCount !== undefined
    ? {
        auth: Boolean(token),
        wishAny: token ? ((await listWishlist(token).catch(() => [])).length ?? 0) > 0 : false,
      }
    : null;
---

<header class="site-header" data-site-header>
  <div class="mx-auto grid max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-x-2 gap-y-2 px-4 py-2 lg:flex lg:gap-x-6 lg:py-3">
    {/* Menú móvil */}
    <button
      type="button"
      popovertarget="menu-movil"
      class:list={[iconBtn, "-ml-2 lg:hidden"]}
      aria-label="Menú"
    >
      <Icon name="list" />
    </button>

    <a
      href="/"
      class="flex items-center gap-2 justify-self-start font-display text-lg font-bold tracking-tight lg:text-xl"
    >
      {/* Fichero estático a 3× en public/: la cabecera también está en páginas on-demand, donde
          <Image> llamaría a sharp en runtime (D6, fase 7-1). */}
      <img
        src="/simbolo-header.webp"
        alt=""
        width="36"
        height="44"
        loading="eager"
        decoding="async"
        class="h-8 w-auto lg:h-9"
      />
      El Rincón de Hiro
    </a>

    {/* Navegación de escritorio */}
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-x-1 text-sm font-semibold">
        <li>
          <button
            type="button"
            popovertarget="menu-tienda"
            class="nav-link inline-flex items-center gap-1"
            aria-current={inShop ? "true" : undefined}
          >
            Tienda <Icon name="caret-down" class="size-4" />
          </button>
          <div id="menu-tienda" popover class="nav-menu nav-menu--tienda">
            <a
              href={allLink.href}
              class="nav-menu__link font-bold"
              aria-current={aria(allLink.href)}
            >
              {allLink.name}
            </a>
            <ul class="nav-menu__cols">
              {shopGroups.map((g) => (
                <li>
                  <a
                    href={g.href}
                    class="nav-menu__link nav-menu__root"
                    aria-current={aria(g.href)}
                  >
                    {g.name}
                  </a>
                  {g.children.length > 0 && (
                    <ul>
                      {g.children.map((c) => (
                        <li>
                          <a
                            href={c.href}
                            class="nav-menu__link text-muted-foreground"
                            aria-current={aria(c.href)}
                          >
                            {c.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
        {mainLinks.map((l) => (
          <li>
            <a href={l.href} class="nav-link" aria-current={aria(l.href)}>
              {l.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Búsqueda (fase 7-1, D5): GET a /buscar/, sin JS. Con JS, SiteClient.astro muestra
        sugerencias en #buscar-sug (fase 7-2). Móvil: 2.ª fila a todo el ancho. */}
    <form
      method="get"
      action={SEARCH_PATH}
      role="search"
      class="relative col-span-3 row-start-2 flex w-full items-center gap-2 lg:ml-auto lg:w-64 xl:w-72"
    >
      <label for="buscar-q" class="sr-only">
        Buscar productos
      </label>
      <input
        id="buscar-q"
        type="search"
        name="q"
        value={q}
        placeholder="Buscar productos"
        enterkeyhint="search"
        autocomplete="off"
        maxlength={100}
        class="h-9 w-full min-w-0 rounded-md border-2 border-line bg-background px-3 text-sm"
      />
      <button
        type="submit"
        class="header-hover h-9 shrink-0 rounded-md border-2 border-line px-2"
        aria-label="Buscar"
      >
        <Icon name="magnifying-glass" class="size-5" />
      </button>
      <div id="buscar-sug" role="listbox" aria-label="Sugerencias" class="suggest" hidden></div>
    </form>

    <div class="-mr-2 flex items-center justify-self-end">
      {/* Selector de tema: sin JS no hace nada, así que nace oculto y SiteClient lo muestra. */}
      {/* En móvil (< lg) va en el menú: con el ♡ no cabía. */}
      <button
        type="button"
        data-theme-toggle
        class:list={[iconBtn, "max-lg:hidden"]}
        aria-label="Cambiar a modo oscuro"
        hidden
      >
        <Icon name="moon" class="size-6 dark:hidden" />
        <Icon name="sun" class="hidden size-6 dark:block" />
      </button>
      <a
        href={WISHLIST_PATH}
        class={iconBtn}
        aria-label="Mi lista de deseos"
        aria-current={current.startsWith(WISHLIST_PATH) ? "page" : undefined}
      >
        {/* Con algo guardado: ♥ rojo con contorno (resalta más que el relleno del icono de
            cuenta, a propósito). */}
        {server ? (
          server.wishAny ? (
            <HeartFilled />
          ) : (
            <Icon name="heart" />
          )
        ) : (
          <>
            <Icon name="heart" class="size-6" data-if-wish-none />
            <HeartFilled data-if-wish-any />
          </>
        )}
      </a>
      <a
        href={ACCOUNT_PATH}
        class={iconBtn}
        aria-label="Mi cuenta"
        aria-current={
          current.startsWith(ACCOUNT_PATH) && !current.startsWith(WISHLIST_PATH)
            ? "page"
            : undefined
        }
      >
        {server ? (
          <Icon name={server.auth ? "user-fill" : "user"} />
        ) : (
          <>
            <Icon name="user" class="size-6" data-if-anon />
            <Icon name="user-fill" class="size-6" data-if-auth />
          </>
        )}
      </a>
      {/* Carrito: enlace a /carrito/ (sin JS); con JS, el script del carrito abre el panel.
          Contador: server island en páginas estáticas. Nombre accesible = texto oculto
          "Carrito" + el número visible ("Carrito 3"): con `aria-label` el nombre no incluía el
          número que se ve (WCAG 2.5.3, Lighthouse label-content-name-mismatch). */}
      <a
        href={CART_PATH}
        data-cart-link
        class:list={[iconBtn, "relative"]}
        aria-current={current === CART_PATH ? "page" : undefined}
      >
        <Icon name="shopping-cart" />
        <span class="sr-only">Carrito</span>
        {cartCount !== undefined ? (
          <CartCountBadge count={cartCount} />
        ) : (
          <HeaderState server:defer>
            <CartCountBadge slot="fallback" />
          </HeaderState>
        )}
      </a>
    </div>
  </div>
</header>

{/* Menú móvil: panel lateral (popover). Fuera del <header> para que su `translate` (ocultar al
    bajar) no lo arrastre: un popover sigue en la capa superior, pero el ancla no importa aquí. */}
<nav id="menu-movil" popover aria-label="Menú" class="mobile-menu lg:hidden">
  <div class="flex items-center justify-between border-b-2 border-line px-4 py-3">
    <span class="font-display text-lg font-bold">Menú</span>
    <button
      type="button"
      popovertarget="menu-movil"
      popovertargetaction="hide"
      class={iconBtn}
      aria-label="Cerrar menú"
    >
      <Icon name="x" />
    </button>
  </div>
  <div class="flex flex-col gap-6 overflow-y-auto px-4 py-4">
    <section aria-labelledby="menu-movil-tienda">
      <h2 id="menu-movil-tienda" class="mb-2 text-xs tracking-wide text-muted-foreground uppercase">
        Tienda
      </h2>
      <ul class="flex flex-col">
        <li>
          <a href={allLink.href} class="mobile-menu__link" aria-current={aria(allLink.href)}>
            {allLink.name}
          </a>
        </li>
        {shopGroups.map((g) => (
          <li>
            {g.children.length > 0 ? (
              <details class="mobile-menu__group" open={current.startsWith(g.href) || undefined}>
                <summary class="mobile-menu__link">{g.name}</summary>
                <ul class="mb-1 ml-3 border-l-2 border-line pl-2">
                  <li>
                    <a href={g.href} class="mobile-menu__link" aria-current={aria(g.href)}>
                      Todo en {g.name}
                    </a>
                  </li>
                  {g.children.map((c) => (
                    <li>
                      <a href={c.href} class="mobile-menu__link" aria-current={aria(c.href)}>
                        {c.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={g.href} class="mobile-menu__link" aria-current={aria(g.href)}>
                {g.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
    <ul class="flex flex-col border-t-2 border-line pt-4">
      {mainLinks.map((l) => (
        <li>
          <a href={l.href} class="mobile-menu__link font-semibold" aria-current={aria(l.href)}>
            {l.name}
          </a>
        </li>
      ))}
      <li>
        <a
          href={ACCOUNT_PATH}
          class="mobile-menu__link font-semibold"
          aria-current={aria(ACCOUNT_PATH)}
        >
          Mi cuenta
        </a>
      </li>
      <li>
        <a
          href={WISHLIST_PATH}
          class="mobile-menu__link font-semibold"
          aria-current={aria(WISHLIST_PATH)}
        >
          Mi lista de deseos
        </a>
      </li>
      <li>
        {/* Selector de tema en móvil (oculto sin JS, como el de la cabecera; SiteClient). */}
        <button
          type="button"
          data-theme-toggle
          class="mobile-menu__link flex w-full items-center gap-2 text-left font-semibold"
          aria-label="Cambiar a modo oscuro"
          hidden
        >
          <Icon name="moon" class="size-5 dark:hidden" />
          <Icon name="sun" class="hidden size-5 dark:block" />
          <span class="dark:hidden">Modo oscuro</span>
          <span class="hidden dark:inline">Modo claro</span>
        </button>
      </li>
    </ul>
  </div>
</nav>
