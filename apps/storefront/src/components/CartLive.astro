---
// Mejora progresiva de /carrito/ (Fase D, 5.3). UN bundle en /_astro/ (≤ 1 KB gzip, sin
// imports; excepción de AGENTS §3.4), SOLO en /carrito/ (allí no se carga CartClient).
// Sin JS: cada línea es un <form> POST con "Actualizar" y "Quitar" (303, aviso con :target).
// Con JS:
//   - al cambiar la cantidad (− / +, teclado), 500 ms después del último cambio se envía el
//     formulario de esa línea con fetch (Accept: JSON → middleware) y "Actualizar" se oculta;
//   - "Quitar" también por fetch;
//   - después se pide /carrito/parcial/ y se sustituye [data-cart-view] (lista y totales) sin
//     recargar; el foco vuelve al mismo control de la misma línea; contador de la cabecera y
//     aviso (región aria-live) con la respuesta. Error de stock → aviso y la cantidad buena.
//   - si algo falla (red, 5xx) → envío normal del formulario (lo mismo que sin JS).
---

<p class="sr-only" aria-live="polite" data-cart-live></p>

<script>
  const live = document.querySelector("[data-cart-live]")!;
  document.documentElement.toggleAttribute("data-cart-live-on", true);
  let timer: ReturnType<typeof setTimeout> | undefined;

  const send = async (form: HTMLFormElement) => {
    const view = document.querySelector<HTMLElement>("[data-cart-view]");
    const line = (form.elements.namedItem("line_id") as HTMLInputElement | null)?.value;
    const kind = form.hasAttribute("data-cart-remove") ? "remove" : "update";
    if (view) view.ariaBusy = "true";
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const r = (await res.json()) as { count: number | null; msg: string };
      const html = await (await fetch("/carrito/parcial/")).text();
      const t = document.createElement("template");
      t.innerHTML = html;
      document.querySelector("[data-cart-view]")?.replaceWith(t.content);
      for (const el of document.querySelectorAll<HTMLElement>("[data-cart-count]")) {
        el.textContent = r.count ? String(r.count) : "";
        el.hidden = !r.count;
      }
      live.textContent = r.msg;
      const f = document.querySelector(
        `form[data-cart-${kind}]:has(input[name=line_id][value="${line}"])`,
      );
      (
        f?.querySelector<HTMLElement>("input[name=quantity]") ??
        document.querySelector<HTMLElement>("[data-cart-view] a, [data-cart-view] button")
      )?.focus();
    } catch {
      form.submit();
    }
  };

  addEventListener("submit", (e) => {
    const form = e.target as HTMLFormElement;
    if (!form.matches("form[data-cart-update], form[data-cart-remove]")) return;
    e.preventDefault();
    clearTimeout(timer);
    void send(form);
  });
  addEventListener("input", (e) => {
    const input = e.target as HTMLInputElement;
    const form = input.form;
    if (!form?.matches("form[data-cart-update]") || !input.checkValidity()) return;
    clearTimeout(timer);
    timer = setTimeout(() => void send(form), 500);
  });
</script>
