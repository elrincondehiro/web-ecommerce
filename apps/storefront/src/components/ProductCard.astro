---
// Tarjeta de producto (HTML estático, 0 JS). Precio y stock vienen del BUILD y llevan marcas
// data-* para que <LiveSync> los corrija (lib/live-sync.ts):
//   data-pid + data-stock (stock) · data-price / data-price-from (precio).
import { Badge } from "$lib/components/ui/badge";
import { getProductPricing, type StoreProduct } from "$lib/catalog";
import { formatPrice } from "$lib/format";
import type { CardImage } from "$lib/images";
import { buttonVariants } from "$lib/components/ui/button";
import AddToCart from "./AddToCart.astro";
import ProductImage from "./ProductImage.astro";

interface Props {
  product: StoreProduct;
  /** Nivel del título: h2 en listados (bajo el h1), h3 en secciones de la home. */
  headingLevel?: 2 | 3 | undefined;
  /** Primeras tarjetas visibles (LCP en listados): carga inmediata. */
  priority?: boolean | undefined;
  /** Ruta de vuelta tras añadir sin JS (la página del listado). */
  back: string;
  /** Páginas on-demand: miniatura del build (o null → placeholder). Ver ProductImage. */
  prebuilt?: CardImage | null | undefined;
}
const { product, headingLevel = 2, priority = false, back, prebuilt } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const href = `/producto/${product.handle}/`;
const pricing = getProductPricing(product);
const image = product.thumbnail ?? product.images?.[0]?.url ?? null;
// Añadir desde el listado solo con UNA variante; con varias → ficha para elegir (fase 4).
const single = pricing.variants.length === 1 ? pricing.variants[0] : undefined;
---

<article
  class="group relative flex w-full flex-col gap-3"
  data-pid={product.id}
  data-stock={pricing.inStock ? "in" : "out"}
>
  <div class="relative overflow-hidden rounded-md">
    <div data-dim class="transition-opacity">
      <ProductImage src={image} alt={product.title} priority={priority} prebuilt={prebuilt} />
    </div>
    <Badge variant="secondary" class="absolute top-2 left-2" data-if-stock="out">
      Agotado
    </Badge>
  </div>
  <div class="flex flex-col gap-1">
    <Heading class="text-sm leading-snug font-medium">
      <a href={href} class="after:absolute after:inset-0 group-hover:underline">
        {product.title}
      </a>
    </Heading>
    {product.subtitle && <p class="text-xs text-muted-foreground">{product.subtitle}</p>}
    <p class="h-5 text-sm tabular-nums">
      {pricing.fromAmount != null && pricing.currencyCode && (
        <>
          <span
            class="text-muted-foreground"
            data-price-from={product.id}
            hidden={!pricing.hasPriceRange}
          >
            Desde
          </span>
          <span class="font-semibold" data-price={product.id}>
            {formatPrice(pricing.fromAmount, pricing.currencyCode)}
          </span>
        </>
      )}
    </p>
  </div>
  {/* Por encima del enlace "estirado" (after:inset-0) para que sea clicable. */}
  {pricing.fromAmount != null && (
    <div class="relative z-10 mt-auto">
      {single ? (
        <AddToCart
          variantId={single.id}
          back={back}
          productId={product.id}
          productTitle={product.title}
          size="sm"
        />
      ) : (
        <a
          href={href}
          class={buttonVariants({ size: "sm", variant: "outline" })}
          aria-label={`Elegir opciones de ${product.title}`}
          data-if-stock="in"
        >
          Elegir opciones
        </a>
      )}
    </div>
  )}
</article>
