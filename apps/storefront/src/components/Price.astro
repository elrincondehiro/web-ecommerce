---
// Precio con IVA y, si hay oferta (Price List `sale`, I-Interficie), precio anterior tachado y
// descuento. HTML del build con marcas para <LiveSync> (lib/live-sync.ts):
//   data-price / data-price-from (precio y "Desde") · data-was-box (oferta sí/no) ·
//   data-was (anterior) · data-off ("−20 %") · data-unit (€/kg o €/l, Fase S S-2).
// El bloque de oferta SIEMPRE se pinta (oculto si no hay): así LiveSync puede mostrarlo si la
// oferta empieza después del build. Accesible: "Precio anterior" y "Precio" para lectores.
// Sin `id` (carrito, Fase D 5.1: HTML on-demand con datos frescos) no lleva marcas de LiveSync
// y el bloque de oferta solo se pinta si hay oferta.
import type { UnitPrice } from "$lib/catalog";
import { formatDiscount, formatPrice, formatUnitPrice } from "$lib/format";

interface Props {
  /** Id del producto o de la variante (clave de LiveSync). Sin id: precio estático. */
  id?: string | undefined;
  amount: number;
  currency: string;
  wasAmount: number | null;
  discountPercent: number | null;
  /** Mostrar "Desde" (solo productos con varios precios). */
  from?: boolean | undefined;
  /** Tamaño: tarjeta (sm) o ficha (lg). */
  size?: "sm" | "lg";
  /** Precio por kilo/litro (RD 3423/2000), en una línea propia debajo. null/omitido: nada. */
  unit?: UnitPrice | null | undefined;
  /** Granel en el carrito (S-3): el importe ya es por kilo («20,00 €/kg», también el anterior). */
  per?: "kg" | undefined;
  /** Texto fijo tras el €/kg (granel: «mínimo 100 g»). */
  unitNote?: string | null | undefined;
  /**
   * `stack` (sitios estrechos de la ficha: tabla de variantes y tarjetas del selector): el precio
   * anterior en su propia línea (con el €/kg) en vez de todo en una fila que desbordaba.
   * Con dos `data-was-box`: LiveSync los muestra u oculta todos (querySelectorAll).
   */
  layout?: "inline" | "stack";
  /** Etiqueta «−20 %». Sin ella en las tarjetas del selector (se repetía en cada una). */
  badge?: boolean;
  /** Clases extra del contenedor (p. ej. centrar en las tarjetas del selector). */
  class?: string | undefined;
}
const {
  id,
  amount,
  currency,
  wasAmount,
  discountPercent,
  from,
  size = "sm",
  unit,
  per,
  unitNote,
  layout = "inline",
  badge = true,
  class: className,
} = Astro.props;
const suffix = per ? `/${per}` : "";
const onSale = wasAmount !== null && discountPercent !== null;
const showWas = id !== undefined || onSale;
const wasText = onSale ? `${formatPrice(wasAmount, currency)}${suffix}` : "";
const offText = onSale ? formatDiscount(discountPercent) : "";
const offClass =
  "self-center rounded-full bg-accent px-1.5 text-[0.7em] leading-5 font-bold text-accent-foreground";
const unitText = unit ? formatUnitPrice(unit.amount, currency, unit.unit) : "";
---

{layout === "stack" ? (
  <span
    class:list={[
      "price inline-flex flex-col gap-0.5 tabular-nums",
      size === "lg" ? "text-2xl" : "text-sm",
      className,
    ]}
  >
    <span class="inline-flex flex-wrap items-baseline gap-x-1.5">
      {from !== undefined && (
        <span
          class="text-[0.75em] font-normal text-muted-foreground"
          data-price-from={id}
          hidden={!from}
        >
          Desde
        </span>
      )}
      <span class="price__now font-semibold" data-price={id}>
        {formatPrice(amount, currency)}
        {suffix}
      </span>
      {showWas && badge && (
        <span class="price__was inline-flex" data-was-box={id} hidden={!onSale}>
          <span class={offClass} data-off={id}>
            {offText}
          </span>
        </span>
      )}
    </span>
    {(showWas || unit) && (
      <span class="inline-flex flex-wrap items-baseline gap-x-1.5 text-xs font-normal text-muted-foreground">
        {showWas && (
          <span class="price__was" data-was-box={id} hidden={!onSale}>
            <span class="sr-only">Precio anterior:</span>
            <del data-was={id}>{wasText}</del>
          </span>
        )}
        {unit && (
          <span>
            <span data-unit={id}>{unitText}</span>
            {unitNote && ` · ${unitNote}`}
          </span>
        )}
      </span>
    )}
  </span>
) : (
  <span
    class:list={[
      "price inline-flex flex-wrap items-baseline gap-x-1.5 tabular-nums",
      size === "lg" ? "text-2xl" : "text-sm",
    ]}
  >
    {from !== undefined && (
      <span
        class="text-[0.75em] font-normal text-muted-foreground"
        data-price-from={id}
        hidden={!from}
      >
        Desde
      </span>
    )}
    <span class="price__now font-semibold" data-price={id}>
      {formatPrice(amount, currency)}
      {suffix}
    </span>
    {(id !== undefined || onSale) && (
      <span
        class="price__was inline-flex items-baseline gap-x-1.5"
        data-was-box={id}
        hidden={!onSale}
      >
        <span class="sr-only">Precio anterior:</span>
        <del class="text-[0.8em] font-normal text-muted-foreground" data-was={id}>
          {onSale ? `${formatPrice(wasAmount, currency)}${suffix}` : ""}
        </del>
        <span
          class="self-center rounded-full bg-accent px-1.5 text-[0.7em] leading-5 font-bold text-accent-foreground"
          data-off={id}
        >
          {onSale ? formatDiscount(discountPercent) : ""}
        </span>
      </span>
    )}
    {unit && (
      <span class="basis-full text-xs font-normal text-muted-foreground">
        <span data-unit={id}>{formatUnitPrice(unit.amount, currency, unit.unit)}</span>
        {unitNote && ` · ${unitNote}`}
      </span>
    )}
  </span>
)}
