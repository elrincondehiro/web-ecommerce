---
// Campo de contraseña (fase 9). Nunca se rellena con un valor (ni tras un error).
// `autocomplete`: "current-password" (entrar) o "new-password" (registro/restablecer).
import Field from "../checkout/Field.astro";
import { PASSWORD_MAX, PASSWORD_MIN } from "$lib/account";

interface Props {
  name?: string;
  label?: string;
  autocomplete: "current-password" | "new-password";
  error?: string | undefined;
  hint?: string | undefined;
}
const { name = "password", label = "Contraseña", autocomplete, error, hint } = Astro.props;
const isNew = autocomplete === "new-password";
---

<Field
  name={name}
  type="password"
  label={label}
  autocomplete={autocomplete}
  required
  minlength={isNew ? PASSWORD_MIN : undefined}
  maxlength={PASSWORD_MAX}
  hint={hint ?? (isNew ? `Mínimo ${PASSWORD_MIN} caracteres, con letras y números.` : undefined)}
  error={error}
/>
