---
// Formulario de una dirección guardada (fase 9): mismos campos y reglas que la de envío del
// checkout (Península + Baleares) + nombre opcional y "predeterminada". Sin JS.
import { buttonVariants } from "$lib/components/ui/button";
import { ADDRESSES_PATH, accountActionUrl } from "$lib/account";
import { SHIPPING_CP_PATTERN } from "$lib/checkout";
import Field from "../checkout/Field.astro";

interface Props {
  /** Id de la dirección (editar) o undefined (nueva). */
  addressId?: string | undefined;
  values: Record<string, string>;
  errors: Record<string, string>;
  /**
   * Mostrar la casilla "predeterminada". Si no se muestra y `values.is_default` es "on" (primera
   * dirección), se envía oculto: la primera siempre es la predeterminada.
   */
  showDefault: boolean;
}
const { addressId, values, errors, showDefault } = Astro.props;
const v = (k: string) => values[k] ?? "";
// Ids únicos por formulario (puede haber varios en la página).
const p = addressId ? `${addressId}-` : "nueva-";
---

<form
  method="post"
  action={accountActionUrl(ADDRESSES_PATH, "account.addressSave")}
  class="flex flex-col gap-4"
>
  {addressId && <input type="hidden" name="address_id" value={addressId} />}
  <Field
    name="address_name"
    id={`f-${p}address_name`}
    label="Nombre de la dirección"
    hint="Por ejemplo: Casa, Trabajo."
    maxlength={40}
    value={v("address_name")}
    error={errors.address_name}
  />
  <div class="grid gap-4 sm:grid-cols-2">
    <Field
      name="first_name"
      id={`f-${p}first_name`}
      label="Nombre"
      autocomplete="shipping given-name"
      required
      maxlength={80}
      value={v("first_name")}
      error={errors.first_name}
    />
    <Field
      name="last_name"
      id={`f-${p}last_name`}
      label="Apellidos"
      autocomplete="shipping family-name"
      required
      maxlength={80}
      value={v("last_name")}
      error={errors.last_name}
    />
    <Field
      name="address_1"
      id={`f-${p}address_1`}
      label="Dirección"
      autocomplete="shipping address-line1"
      required
      maxlength={120}
      value={v("address_1")}
      error={errors.address_1}
      class="sm:col-span-2"
    />
    <Field
      name="address_2"
      id={`f-${p}address_2`}
      label="Piso, puerta, escalera…"
      autocomplete="shipping address-line2"
      maxlength={120}
      value={v("address_2")}
      error={errors.address_2}
      class="sm:col-span-2"
    />
    <Field
      name="postal_code"
      id={`f-${p}postal_code`}
      label="Código postal"
      autocomplete="shipping postal-code"
      inputmode="numeric"
      required
      pattern={SHIPPING_CP_PATTERN}
      maxlength={5}
      hint="Península y Baleares."
      value={v("postal_code")}
      error={errors.postal_code}
    />
    <Field
      name="city"
      id={`f-${p}city`}
      label="Población"
      autocomplete="shipping address-level2"
      required
      maxlength={80}
      value={v("city")}
      error={errors.city}
    />
    <Field
      name="phone"
      id={`f-${p}phone`}
      type="tel"
      label="Teléfono"
      autocomplete="shipping tel"
      required
      maxlength={20}
      hint="Para la empresa de transporte."
      value={v("phone")}
      error={errors.phone}
    />
  </div>
  {!showDefault && v("is_default") === "on" && <input type="hidden" name="is_default" value="on" />}
  {showDefault && (
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="is_default" checked={v("is_default") === "on"} class="size-4" />
      Usar como dirección de envío predeterminada
    </label>
  )}
  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class={buttonVariants()}>
      Guardar dirección
    </button>
    {addressId && (
      <a href={ADDRESSES_PATH} class="text-sm underline underline-offset-4">
        Cancelar
      </a>
    )}
  </div>
</form>
