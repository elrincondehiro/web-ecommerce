---
// Mejora progresiva del carrito (fase 4): UN único bundle (≤ 2 KB gzip, check:budget).
// Sin framework (medido en fase4.md §2.3: Svelte ≈ 23 KB, nanostores +0,4 KB).
//   - Intercepta los <form data-cart-form> y los envía con fetch (Accept: JSON → middleware).
//   - Actualiza todos los [data-cart-count] con animación (clase "bump", CSS).
//   - Toasts globales por eventos DOM: dispatchEvent(new CustomEvent("toast", {detail:{msg,kind}}))
//     → cualquier isla futura (fases 5/7) puede lanzarlos.
//   - Panel del carrito (Fase D, 3.2): `popover` (no <dialog> modal: con el modal la página es
//     inerte). El icono lo abre; se cierra con ✕, Escape o pulsando fuera (light dismiss; ese
//     clic lo anula SiteClient, 3.1). Lateral derecho a toda altura (móvil: 88 %). HTML del partial
//     /carrito/flyout/. Al añadir: el panel solo se abre en escritorio; en móvil, el toast.
// Sin JS no se carga nada de esto: el icono es un enlace a /carrito/ y los formularios hacen
// POST → 303 con el aviso en CSS (:target).
---

<div id="toasts" class="toasts" role="status" aria-live="polite"></div>
<div id="cart-flyout" popover class="flyout" role="dialog" aria-labelledby="cart-flyout-title">
  <div class="flex items-center justify-between border-b px-4 py-3">
    <h2 id="cart-flyout-title" class="font-semibold">
      Carrito
    </h2>
    <button
      type="button"
      popovertarget="cart-flyout"
      popovertargetaction="hide"
      class="rounded-md px-2 py-1 text-sm hover:bg-muted"
      aria-label="Cerrar carrito"
    >
      ✕
    </button>
  </div>
  {/* Lista (con scroll) + pie fijo con total y "Ver carrito": los pone CartView (flyout). */}
  <div data-flyout-body class="flex min-h-0 flex-1 flex-col" aria-busy="true"></div>
</div>

<script>
  const FLYOUT_URL = "/carrito/flyout/";
  const desktop = matchMedia("(min-width: 768px)");
  const box = document.getElementById("toasts")!;
  const panel = document.getElementById("cart-flyout")!;
  const body = panel.querySelector<HTMLElement>("[data-flyout-body]")!;

  type Kind = "ok" | "error";

  function toast(msg: string, kind: Kind = "ok") {
    const el = document.createElement("div");
    el.className = `toast toast-${kind}`;
    if (kind === "error") el.setAttribute("role", "alert");
    const text = document.createElement("span");
    text.textContent = msg;
    const close = document.createElement("button");
    close.type = "button";
    close.textContent = "✕";
    close.setAttribute("aria-label", "Cerrar aviso");
    el.append(text, close);
    const hide = () => {
      el.classList.add("out");
      el.addEventListener("transitionend", () => el.remove(), { once: true });
      // Sin transición (prefers-reduced-motion) transitionend no llega
      setTimeout(() => el.remove(), 400);
    };
    close.onclick = hide;
    setTimeout(hide, 4000);
    box.append(el);
  }

  addEventListener("toast", (e) => {
    const d = (e as CustomEvent<{ msg?: string; kind?: Kind }>).detail;
    if (d?.msg) toast(d.msg, d.kind);
  });

  function setCount(count: number) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-cart-count]")) {
      el.textContent = count > 0 ? String(count) : "";
      el.hidden = count <= 0;
      el.classList.remove("bump");
      void el.offsetWidth; // reinicia la animación
      el.classList.add("bump");
    }
  }

  async function openFlyout() {
    body.setAttribute("aria-busy", "true");
    if (!panel.matches(":popover-open")) panel.showPopover();
    try {
      const res = await fetch(FLYOUT_URL, { headers: { Accept: "text/html" } });
      if (!res.ok) throw new Error(String(res.status));
      // HTML de nuestro propio servidor, sin scripts (partial de CartView.astro)
      body.innerHTML = await res.text();
    } catch {
      panel.hidePopover();
      location.href = "/carrito/";
    } finally {
      body.removeAttribute("aria-busy");
    }
  }

  const send = (e: Event) => {
    const form = e.target as HTMLFormElement;
    // "Quitar" en el panel (Fase D, 5.4): fetch y se vuelve a pedir el panel.
    if (form.matches("#cart-flyout form[data-cart-remove]")) {
      e.preventDefault();
      body.setAttribute("aria-busy", "true");
      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      })
        .then((r) => r.json() as Promise<{ count: number | null; msg: string }>)
        .then((r) => {
          if (r.count != null) setCount(r.count);
          toast(r.msg);
          return openFlyout();
        })
        .catch(() => form.submit());
      return;
    }
    if (!form.matches("form[data-cart-form]")) return;
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button?.disabled) return;
    if (button) button.disabled = true;
    fetch(form.action, {
      method: "POST",
      body: new FormData(form),
      headers: { Accept: "application/json" },
    })
      .then((r) => r.json() as Promise<{ code: string; count: number | null; msg: string }>)
      .then((r) => {
        const ok = r.code === "added";
        if (r.count != null) setCount(r.count);
        toast(r.msg, ok ? "ok" : "error");
        if (ok && desktop.matches) void openFlyout();
      })
      .catch(() => toast("No se ha podido añadir. Inténtalo de nuevo.", "error"))
      .finally(() => {
        if (button) button.disabled = false;
      });
  };
  addEventListener("submit", send);

  // Icono del carrito: abre el panel (móvil y escritorio). Ctrl/⌘/⇧ + clic: enlace normal.
  addEventListener("click", (e) => {
    const link = (e.target as Element).closest?.("a[data-cart-link]");
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    void openFlyout();
  });
</script>
