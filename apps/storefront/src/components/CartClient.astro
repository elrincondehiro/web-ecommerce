---
// Mejora progresiva del carrito (fase 4): UN único bundle (≤ 2 KB gzip, check:budget).
// Sin framework (medido en fase4.md §2.3: Svelte ≈ 23 KB, nanostores +0,4 KB).
//   - Intercepta los <form data-cart-form> y los envía con fetch (Accept: JSON → middleware).
//   - Actualiza todos los [data-cart-count] con animación (clase "bump", CSS).
//   - Toasts globales por eventos DOM: dispatchEvent(new CustomEvent("toast", {detail:{msg,kind}}))
//     → cualquier isla futura (fases 5/7) puede lanzarlos.
//   - Panel del carrito (Fase D, 3.2): `popover` (no <dialog> modal: con el modal la página es
//     inerte). El icono lo abre; se cierra con ✕, Escape o pulsando fuera (light dismiss; ese
//     clic lo anula SiteClient, 3.1). Lateral derecho a toda altura (móvil: 88 %). HTML del partial
//     /carrito/flyout/. Al añadir: el panel solo se abre en escritorio; en móvil, el toast.
//   - Lista de deseos (Fase L-1): botones [data-wish] → fetch a su formaction + toast (o a
//     «Entrar» si no hay sesión). Sin JS, el formulario hace POST → 303.
//   - Granel (S-3, CATALOG_FEATURES.bulkLiveTotal): «Total: 5,00 €» junto al campo de gramos
//     ([data-bulk-total]) = gramos × €/kg del [data-unit] de la página (el de la variante elegida
//     si hay varias). Envío con el botón pulsado (accesos rápidos: name="preset").
// Sin JS no se carga nada de esto: el icono es un enlace a /carrito/ y los formularios hacen
// POST → 303 con el aviso en CSS (:target).
---

<div id="toasts" class="toasts" role="status" aria-live="polite"></div>
<div id="cart-flyout" popover class="flyout" role="dialog" aria-labelledby="cart-flyout-title">
  <div class="flex items-center justify-between border-b px-4 py-3">
    <h2 id="cart-flyout-title" class="font-semibold">
      Carrito
    </h2>
    <button
      type="button"
      popovertarget="cart-flyout"
      popovertargetaction="hide"
      class="rounded-md px-2 py-1 text-sm hover:bg-muted"
      aria-label="Cerrar carrito"
    >
      ✕
    </button>
  </div>
  {/* Lista (con scroll) + pie fijo con total y "Ver carrito": los pone CartView (flyout). */}
  <div data-flyout-body class="flex min-h-0 flex-1 flex-col" aria-busy="true"></div>
</div>

<script>
  const FLYOUT_URL = "/carrito/flyout/";
  const desktop = matchMedia("(min-width: 768px)");
  const box = document.getElementById("toasts")!;
  const panel = document.getElementById("cart-flyout")!;
  const body = panel.querySelector<HTMLElement>("[data-flyout-body]")!;

  type Kind = "ok" | "error";

  function toast(msg: string, kind: Kind = "ok") {
    const el = document.createElement("div");
    el.className = `toast toast-${kind}`;
    if (kind === "error") el.setAttribute("role", "alert");
    const text = document.createElement("span");
    text.textContent = msg;
    const close = document.createElement("button");
    close.type = "button";
    close.textContent = "✕";
    close.setAttribute("aria-label", "Cerrar aviso");
    el.append(text, close);
    const hide = () => {
      el.classList.add("out");
      el.addEventListener("transitionend", () => el.remove(), { once: true });
      // Sin transición (prefers-reduced-motion) transitionend no llega
      setTimeout(() => el.remove(), 400);
    };
    close.onclick = hide;
    setTimeout(hide, 4000);
    box.append(el);
  }

  addEventListener("toast", (e) => {
    const d = (e as CustomEvent<{ msg?: string; kind?: Kind }>).detail;
    if (d?.msg) toast(d.msg, d.kind);
  });

  function setCount(count: number) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-cart-count]")) {
      el.textContent = count > 0 ? String(count) : "";
      el.hidden = count <= 0;
      el.classList.remove("bump");
      void el.offsetWidth; // reinicia la animación
      el.classList.add("bump");
    }
  }

  async function openFlyout() {
    body.setAttribute("aria-busy", "true");
    if (!panel.matches(":popover-open")) panel.showPopover();
    try {
      const res = await fetch(FLYOUT_URL, { headers: { Accept: "text/html" } });
      if (!res.ok) throw new Error(String(res.status));
      // HTML de nuestro propio servidor, sin scripts (partial de CartView.astro)
      body.innerHTML = await res.text();
    } catch {
      panel.hidePopover();
      location.href = "/carrito/";
    } finally {
      body.removeAttribute("aria-busy");
    }
  }

  const eur = new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR" });
  function bulkTotal(form: HTMLFormElement) {
    const out = form.querySelector<HTMLElement>("[data-bulk-total]");
    const g = form.querySelector<HTMLInputElement>("input[name=grams]");
    if (!out || !g) return;
    const key =
      out.dataset.bulkTotal ||
      form.querySelector<HTMLInputElement>("input[name=variant_id]:checked")?.value;
    const kg = parseFloat(
      (document.querySelector(`[data-unit="${key}"]`)?.textContent ?? "")
        .replace(/[^\d,]/g, "")
        .replace(",", "."),
    );
    out.textContent =
      kg && g.value && g.checkValidity()
        ? `Total: ${eur.format(Math.round((+g.value * kg) / 10) / 100)}`
        : "";
  }
  addEventListener("input", (e) => {
    const form = (e.target as HTMLInputElement).form;
    if (form?.matches("form[data-cart-form]")) bulkTotal(form);
  });
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-cart-form]")) {
    bulkTotal(form);
  }

  const send = (e: SubmitEvent) => {
    const form = e.target as HTMLFormElement;
    // Cerrar sesión: fuera la pista de la cabecera (la siguiente página sale ya sin sesión).
    if (form.action.includes("logout")) localStorage.removeItem("cabecera");
    // Lista de deseos (L-1): botón ♡ [data-wish] (formulario propio o, en la ficha, el de Añadir
    // con `form`). Toast y ♥ rojo, o sin sesión a «Entrar» (el servidor deja el pendiente).
    const wish = e.submitter as HTMLButtonElement | null;
    if (wish?.hasAttribute("data-wish")) {
      e.preventDefault();
      const box = wish.closest<HTMLElement>("[data-wish-box]");
      fetch(wish.formAction, {
        method: "POST",
        body: new FormData(form, wish),
        headers: { Accept: "application/json" },
      })
        .then((r) => r.json() as Promise<{ msg: string; kind: Kind; login: string | null }>)
        .then((r) => {
          if (r.login) return location.assign(r.login);
          toast(r.msg, r.kind);
          if (r.kind == "ok" && box) {
            saved.add(box.dataset.wishKey!);
            root.dataset.wishAny = "";
            paint();
            hint();
          }
        })
        .catch(() => toast("No se ha podido guardar. Inténtalo de nuevo.", "error"));
      return;
    }
    // "Quitar" en el panel (Fase D, 5.4): fetch y se vuelve a pedir el panel.
    if (form.matches("#cart-flyout form[data-cart-remove]")) {
      e.preventDefault();
      body.setAttribute("aria-busy", "true");
      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      })
        .then((r) => r.json() as Promise<{ count: number | null; msg: string }>)
        .then((r) => {
          if (r.count != null) setCount(r.count);
          toast(r.msg);
          return openFlyout();
        })
        .catch(() => form.submit());
      return;
    }
    if (!form.matches("form[data-cart-form]")) return;
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (button?.disabled) return;
    if (button) button.disabled = true;
    fetch(form.action, {
      method: "POST",
      body: new FormData(form, e.submitter),
      headers: { Accept: "application/json" },
    })
      .then((r) => r.json() as Promise<{ code: string; count: number | null; msg: string }>)
      .then((r) => {
        const ok = r.code === "added";
        if (r.count != null) setCount(r.count);
        toast(r.msg, ok ? "ok" : "error");
        if (ok && desktop.matches) void openFlyout();
      })
      .catch(() => toast("No se ha podido añadir. Inténtalo de nuevo.", "error"))
      .finally(() => {
        if (button) button.disabled = false;
      });
  };
  addEventListener("submit", send);

  // Estado de la lista (L-1): <template data-wish-state> de la island de la cabecera
  // (HeaderState: {a, p, v, n}). Marca <html data-auth / data-wish-any> y data-saved en los ♡
  // guardados. La island llega después de cargar: se espera con un MutationObserver.
  const root = document.documentElement;
  const saved = new Set<string>();
  // Pista para la próxima página (lib/theme-init.ts, HEADER_HINT_KEY): sin datos personales.
  // Sin localStorage (modo privado estricto) lanza: solo se pierde la pista.
  const hint = () => {
    try {
      localStorage.cabecera = root.dataset.wishAny == null ? "a" : "aw";
      if (root.dataset.auth == null) localStorage.removeItem("cabecera");
    } catch {
      /* sin pista */
    }
  };
  const paint = () => {
    for (const b of document.querySelectorAll<HTMLElement>("[data-wish-box]"))
      b.toggleAttribute("data-saved", saved.has(b.dataset.wishKey!));
  };
  const readState = () => {
    const t = document.querySelector("template[data-wish-state]");
    if (!t) return false;
    const d = JSON.parse(t.innerHTML) as { a: number; p?: string[]; v?: string[]; n?: number };
    // El estado real manda sobre la pista que aplicó el <head> (sesión caducada, lista vacía…).
    root.toggleAttribute("data-auth", !!d.a);
    root.toggleAttribute("data-wish-any", !!d.n);
    for (const k of [...(d.p ?? []), ...(d.v ?? [])]) saved.add(k);
    t.remove();
    paint();
    hint();
    return true;
  };
  if (!readState()) {
    const o = new MutationObserver(() => readState() && o.disconnect());
    o.observe(document.body, { childList: true, subtree: true });
  }
  // Compartir la lista (L-1b, /cuenta/deseos/): «Copiar enlace» y, si hay Web Share, «Compartir…».
  const url = document.querySelector<HTMLInputElement>("[data-share-url]");
  if (url) {
    const copy = document.querySelector<HTMLButtonElement>("[data-share-copy]")!;
    const native = document.querySelector<HTMLButtonElement>("[data-share-native]")!;
    // Sin contexto seguro (http por la IP de la LAN en desarrollo) no hay navigator.clipboard ni
    // navigator.share: se copia seleccionando el campo (execCommand, obsoleto pero sin
    // alternativa ahí). «Compartir…» solo aparece con Web Share (https en producción).
    copy.hidden = false;
    copy.onclick = () => {
      const done = () => toast("Enlace copiado");
      const legacy = () => {
        url.select();
        if (document.execCommand("copy")) done();
      };
      if (navigator.clipboard) navigator.clipboard.writeText(url.value).then(done, legacy);
      else legacy();
    };
    if (navigator.share) {
      native.hidden = false;
      native.onclick = () =>
        navigator.share({ title: "Mi lista de deseos", url: url.value }).catch(() => {});
    }
  }
  // Ficha con variantes: el ♡ del título sigue a la variante elegida (data-wish-follow = id del
  // formulario de Añadir): radio de la tabla o, en el selector de opciones (Fase O), la marca de
  // la combinación elegida (VariantPicker: `data-pid` hermana del radio marcado).
  addEventListener("change", (e) => {
    const f = (e.target as HTMLInputElement).form;
    const a = f?.querySelector<HTMLElement>("[data-ai]:checked")?.dataset.ai;
    const k =
      f?.querySelector<HTMLInputElement>("[name=variant_id]:checked")?.value ??
      f?.querySelector<HTMLElement>(
        `[name=opcion_2]:checked~[data-pa="${a}"],[name=opcion_1]:checked~[data-pid]`,
      )?.dataset.pid;
    if (!k) return;
    for (const b of document.querySelectorAll<HTMLElement>(`[data-wish-follow="${f!.id}"]`))
      b.dataset.wishKey = k;
    paint();
  });

  // Icono del carrito: abre el panel (móvil y escritorio). Ctrl/⌘/⇧ + clic: enlace normal.
  addEventListener("click", (e) => {
    const link = (e.target as Element).closest?.("a[data-cart-link]");
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    void openFlyout();
  });
</script>
