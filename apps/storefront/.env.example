# Storefront (Astro). Copiar a apps/storefront/.env
# Ninguna variable llega al navegador: todas son de servidor (astro:env, context "server").

# URL pública del sitio (canonical, sitemap, Open Graph). Se fija en el BUILD; también define el
# host de confianza detrás de Caddy (security.allowedDomains, fase 10).
SITE_URL=http://localhost:4321

# Solo desarrollo: hosts extra de confianza (se fijan en el BUILD), p. ej. para entrar desde el
# móvil por la IP de la LAN. Lista separada por comas; sin protocolo = http. Sin esto, los
# formularios (login, carrito…) por http://<IP> dan «Cross-site POST form submissions are
# forbidden». Vacía en producción.
# DEV_ALLOWED_HOSTS=192.168.1.39:4321

# API de Medusa (build + server islands). Se lee también en RUNTIME (fase 10): en Docker el
# contenedor puede usar la red interna (http://backend-server:9000).
MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key del canal "Tienda online" (sale en el log de `pnpm backend:seed`)
MEDUSA_PUBLISHABLE_KEY=pk_xxx

# Origen de datos del build: medusa (por defecto) | fixtures (CI sin backend)
STOREFRONT_DATA=medusa

# Opcional: limitar el build a los N primeros productos (medición / preview rápida)
# STOREFRONT_MAX_PRODUCTS=100

# Opcional: clave fija para cifrar props de server islands (rolling deploys / CDN).
# Generar con: pnpm --filter storefront exec astro create-key
# ASTRO_KEY=

# Origen público de las imágenes de producto (fase 6). Se optimizan en build con <Picture>.
# dev: bucket SeaweedFS · prod: dominio público de R2 (p. ej. https://img.elrincondehiro.com)
IMAGE_BASE_URL=http://localhost:8333/medusa

# Atributo Secure de la cookie del carrito (fase 4). true por defecto (producción, https).
# Solo en local por http (p. ej. http://10.0.10.18:4321) poner false.
COOKIE_SECURE=true

# Clave PUBLICABLE de Stripe en modo TEST (fase 5): pk_test_… (Dashboard → Developers → API keys).
# Se envía al navegador (data- del checkout) para montar el Payment Element. Nunca una sk_ ni pk_live_.
# Sin ella el checkout muestra el paso de pago como no disponible. Se lee en RUNTIME (fase 10).
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Opcional (fase 7-1): cabecera Server-Timing (search/cards/data) en /buscar/. Solo tiempos.
# Por defecto false (limpieza en producción). Se lee en runtime.
# SERVER_TIMING=true

# Opcional (fase 7-1, D9): caché en memoria de precio/stock de las tarjetas de /buscar/,
# en segundos (0 = desactivada, siempre fresco). Por defecto 30.
# SEARCH_CARD_CACHE_TTL=30

# Opcional (fase 7-2): caché en memoria de las sugerencias de búsqueda (HTML por texto, máx. 500),
# en segundos (0 = desactivada). Por defecto 60.
# SEARCH_SUGGEST_CACHE_TTL=60
