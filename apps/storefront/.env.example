# Storefront (Astro). Copiar a apps/storefront/.env
# Ninguna variable llega al navegador: todas son de servidor (astro:env, context "server").

# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:4321

# API de Medusa (build + server islands)
MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key del canal "Tienda online" (sale en el log de `pnpm backend:seed`)
MEDUSA_PUBLISHABLE_KEY=pk_xxx

# Origen de datos del build: medusa (por defecto) | fixtures (CI sin backend)
STOREFRONT_DATA=medusa

# Opcional: limitar el build a los N primeros productos (medición / preview rápida)
# STOREFRONT_MAX_PRODUCTS=100

# Opcional: clave fija para cifrar props de server islands (rolling deploys / CDN).
# Generar con: pnpm --filter storefront exec astro create-key
# ASTRO_KEY=

# Origen público de las imágenes de producto (fase 6). Se optimizan en build con <Picture>.
# dev: bucket SeaweedFS · prod: dominio público de R2 (p. ej. https://img.elrincondehiro.com)
IMAGE_BASE_URL=http://localhost:8333/medusa
