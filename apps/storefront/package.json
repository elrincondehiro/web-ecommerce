{
  "name": "storefront",
  "version": "0.0.1",
  "private": true,
  "description": "Storefront Astro 7 de web-ecommerce",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "astro": "astro",
    "typecheck": "astro sync && astro check && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "check:budget": "node ./scripts/check-js-budget.mjs",
    "fixtures:update": "node ./scripts/update-fixtures.mjs",
    "start": "HOST=0.0.0.0 PORT=4321 node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/types": "2.21.2",
    "@stripe/stripe-js": "9.17.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "sharp": "0.35.5",
    "svelte": "5.57.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
