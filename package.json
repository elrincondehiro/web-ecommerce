{
  "name": "web-ecommerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "infra:up": "docker compose --env-file docker/.env -f docker/compose.dev.yml up -d --wait",
    "infra:down": "docker compose --env-file docker/.env -f docker/compose.dev.yml down",
    "infra:ps": "docker compose --env-file docker/.env -f docker/compose.dev.yml ps",
    "infra:logs": "docker compose --env-file docker/.env -f docker/compose.dev.yml logs -f",
    "infra:stripe": "docker compose --env-file docker/.env -f docker/compose.dev.yml --profile stripe up -d stripe-cli",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:emails": "pnpm --filter emails preview",
    "backend:seed": "pnpm --filter backend seed",
    "backend:stock:mock": "pnpm --filter backend stock:mock",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@web-ecommerce/config": "workspace:*",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
